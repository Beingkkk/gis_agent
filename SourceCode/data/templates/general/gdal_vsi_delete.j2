{# @id gdal_vsi_delete #}
{# @name VSI虚拟文件系统删除 #}
{# @description 删除GDAL虚拟文件系统中的文件或目录，支持/vsimem、/vsizip、/vsicurl等虚拟路径 #}
{# @keyword vsi #}
{# @keyword delete #}
{# @keyword rm #}
{# @keyword 虚拟文件系统 #}
{# @keyword 文件删除 #}
{# @keyword vsizip #}
{# @keyword vsicurl #}
{# @concept "GDAL虚拟文件系统(VSI)是一套抽象文件访问接口，支持访问压缩包内文件、网络文件、内存文件系统等" #}
{# @concept "gdal vsi delete 等同于UNIX的rm命令，可操作本地文件系统及各种虚拟文件系统" #}
{# @note 支持删除本地文件、目录以及虚拟文件系统中的文件（如/vsizip/archive.gpkg内的文件） #}
{# @note 此操作不可撤销，删除前请务必确认路径正确 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Unable to delete" — 文件或目录不存在，或权限不足导致无法删除 #}
{# @common_error "Not a directory" — 尝试递归删除(-r)一个普通文件，需省略-r参数 #}
{# @param filename file_path required 要删除的文件或目录路径（支持GDAL VSI虚拟路径如/vsimem、/vsizip、/vsicurl等） #}
{# @param recursive boolean optional 递归删除目录及其内容 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vsi_delete

gdal vsi delete{% if recursive %} -r{% endif %} {{ filename | quote }}

REM Done
