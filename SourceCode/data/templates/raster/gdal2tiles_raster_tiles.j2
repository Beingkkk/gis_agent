{# @id gdal2tiles_raster_tiles #}
{# @name 栅格瓦片生成 #}
{# @description 将栅格数据转换为 Web 瓦片地图，支持 TMS、XYZ 等瓦片规格，用于在 Leaflet、OpenLayers 等地图库中快速加载 #}
{# @keyword 瓦片 #}
{# @keyword tiles #}
{# @keyword tms #}
{# @keyword xyz #}
{# @keyword osm #}
{# @keyword wmts #}
{# @keyword 切片 #}
{# @keyword web地图 #}
{# @keyword 地图服务 #}
{# @concept "gdal2tiles 将栅格图像切割为符合 OSGeo Tile Map Service (TMS) 或 XYZ 标准的瓦片金字塔，支持 Google Maps、OpenLayers、Leaflet 等主流 Web 地图库" #}
{# @concept "Web 墨卡托投影 (EPSG:3857) 是最通用的瓦片方案，与 OSM、百度、高德等在线地图兼容；EPSG:4326 可生成 KML 超叠加供 Google Earth 使用" #}
{# @note 输入数据类型若为非 Byte 类型（如 Int16），会被自动截断为 0-255，建议先用 gdal_translate 转为 Byte 类型以避免数据失真 #}
{# @note GDAL 3.13+ 版本已默认迁移到 'gdal raster tile' 实现，仅在需要兼容旧行为时才使用 --legacy 参数 #}
{# @seealso gdal2ogr_convert #}
{# @seealso gdal_translate_convert #}
{# @common_error "Input file size exceeds maximum supported by driver" — 输入栅格过大或驱动不支持该格式，尝试用 gdal_translate 先转为 GeoTIFF 格式 #}
{# @common_error "No tiles generated" — 缩放级别范围设置不当，或源数据分辨率不足以生成指定级别的瓦片，需调整 -z 参数范围 #}
{# @param input file_path required 输入栅格文件路径（如 GeoTIFF、ECW 等格式） #}
{# @param output folder_path optional 输出瓦片目录路径，默认为当前目录 #}
{# @param zoom string optional 缩放级别范围，格式为 'min-max' 或单个值，如 '2-5' #}
{# @param profile enum optional 瓦片切割方案 default=mercator options=mercator,geodetic,raster #}
{# @param resampling enum optional 重采样方法 default=average options=average,near,bilinear,cubic,cubicspline,lanczos,mode,max,min,med,q1,q3 #}
{# @param tilesize integer optional 瓦片像素尺寸 default=256 #}
{# @param tiledriver format optional 输出瓦片格式驱动 default=GTiff options=GTiff,PNG,JPEG #}
{# @param s_srs crs optional 源数据空间参考系统定义（如 EPSG:4326） #}
{# @param xyz boolean optional 生成 XYZ 格式瓦片（OSM 标准）而非 TMS 瓦片 #}
{# @param title string optional 生成的网页标题 #}
{# @param url string optional 瓦片路径的 URL 前缀（用于发布） #}
{# @param webviewer enum optional 生成的内置网页查看器类型 options=googlemaps,openlayers,leaflet,ol3,none #}
{# @param not_overwrite boolean optional 不覆盖已存在的瓦片文件 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal2tiles_raster_tiles

gdal2tiles{% if output %} {{ output | safe_path | quote }}{% endif %} {{ input | safe_path | quote }}{% if zoom %} -z {{ zoom | quote }}{% endif %}{% if profile %} -p {{ profile | quote }}{% endif %}{% if resampling %} -r {{ resampling | quote }}{% endif %}{% if tilesize %} --tilesize={{ tilesize }}{% endif %}{% if tiledriver %} --tiledriver={{ tiledriver | quote }}{% endif %}{% if s_srs %} -s {{ s_srs | quote }}{% endif %}{% if xyz %} --xyz{% endif %}{% if title %} -t {{ title | quote }}{% endif %}{% if url %} -u {{ url | quote }}{% endif %}{% if webviewer %} -w {{ webviewer | quote }}{% endif %}{% if not_overwrite %} -e{% endif %}

