{# @id gdal_raster_pixel_info #}
{# @name 栅格像元值查询 #}
{# @description 查询栅格数据中指定位置的像素值及坐标信息，支持CSV和GeoJSON格式输出 #}
{# @keyword raster #}
{# @keyword pixel #}
{# @keyword 像元 #}
{# @keyword 栅格查询 #}
{# @keyword tif #}
{# @keyword 波段值 #}
{# @keyword GeoJSON #}
{# @concept "gdal raster pixel-info 可以查询栅格数据中任意位置的像素值，支持像素坐标和地理坐标两种查询方式" #}
{# @concept "该工具可输出GeoJSON格式显示哪些源文件贡献了该像素值（对VRT文件尤其有用）" #}
{# @note 坐标输入支持三种方式：标准输入流每行一个坐标对、通过 --position 参数、或通过矢量数据集批量查询 #}
{# @note 波段值会以原始值和缩放后值两种形式报告，便于理解实际地物属性 #}
{# @seealso gdal_raster_info #}
{# @seealso gdal_raster_translate #}
{# @common_error "Pixel is out of bounds" — 查询的坐标超出了栅格数据的范围，需检查坐标系统设置是否正确 #}
{# @common_error "Band index out of range" — 指定的波段编号不存在，需检查栅格实际波段数 #}
{# @param input file_path required 输入栅格数据文件路径（支持GeoTIFF、HDF等格式） #}
{# @param position string optional 像素位置坐标，格式为 column,line 或 X,Y #}
{# @param position_dataset file_path optional 包含坐标点的矢量数据集，用于批量查询 #}
{# @param layer string optional 矢量数据集中的图层名称 #}
{# @param band string optional 要查询的波段编号（1-based索引），可指定多个波段 #}
{# @param position_crs crs optional 坐标参考系统，默认按像素坐标处理，也可指定如 EPSG:4326 的地理坐标 #}
{# @param overview integer optional 使用概览级别（0为原始分辨率，1+为降低分辨率） #}
{# @param resampling enum optional 重采样算法 default=nearest options=nearest,bilinear,cubic,cubicspline #}
{# @param of format optional 输出格式 default=GeoJSON options=GeoJSON,CSV #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_raster_pixel_info

gdal raster pixel-info {% if band %} -b {{ band | quote }}{% endif %}{% if overview %} --overview {{ overview | quote }}{% endif %}{% if position_crs %} --position-crs {{ position_crs | quote }}{% endif %}{% if resampling %} -r {{ resampling | quote }}{% endif %}{% if of %} -f {{ of | quote }}{% endif %}{% if position_dataset %} --position-dataset {{ position_dataset | safe_path | quote }}{% endif %}{% if layer %} -l {{ layer | quote }}{% endif %}{% if position %} -p {{ position | quote }}{% endif %} {{ input | safe_path | quote }}

REM Done
