{# @id gdal_raster_viewshed #}
{# @name 视域分析 #}
{# @description 从数字高程模型(DEM)计算观察者可视区域，生成可见性二值栅格 #}
{# @keyword DEM #}
{# @keyword shp #}
{# @keyword 视域 #}
{# @keyword 可视域 #}
{# @keyword visibility #}
{# @keyword viewshed #}
{# @keyword 高程 #}
{# @keyword 可见性 #}
{# @keyword 地形 #}
{# @concept "视域分析是地形分析的重要工具，通过计算DEM中每个栅格相对于观察者位置的可见性，输出二值栅格表示可视与不可见区域" #}
{# @concept "支持多种模式：normal模式输出可见/不可见二值栅格；DEM模式输出最小可视高度栅格；ground模式输出地面以上可见高度；cumulative模式累计可视性" #}
{# @note 观察者位置必须指定为X,Y坐标，Y坐标可以是经纬度或投影坐标，取决于DEM的坐标系 #}
{# @note 使用角度参数(start_angle/end_angle)可以限定视野范围，适用于塔台、监控点等场景 #}
{# @seealso gdal_dem #}
{# @common_error "observer location out of bounds" — 观察者坐标超出DEM范围，检查输入坐标是否正确或DEM的空间范围 #}
{# @common_error "Invalid band number" — 指定的波段编号超出DEM的实际波段数，默认使用第1波段 #}
{# @param input file_path required 输入栅格数据集（通常是DEM高程数据） #}
{# @param output file_path required 输出视域分析结果栅格路径 #}
{# @param pos string optional 观察者位置坐标，格式为 X,Y 或 X,Y,H（X坐标,Y坐标,观察者高度） #}
{# @param height float optional 观察者距离地面的高度（高程单位） #}
{# @param of format optional 输出栅格格式 options=GTiff,GPKG,HFA,EHdr #}
{# @param mode enum optional 视域计算模式 default=normal options=normal,DEM,ground,cumulative #}
{# @param target_height float optional 目标物高度（高于DEM表面的高度，默认0） #}
{# @param max_distance float optional 最大可视距离，超出范围的区域标记为不可见 #}
{# @param min_distance float optional 最小掩膜距离，观察者附近小于此距离的区域不显示 #}
{# @param start_angle float optional 水平视野起始角度（从正北顺时针，度） #}
{# @param end_angle float optional 水平视野终止角度（从正北顺时针，度） #}
{# @param band integer optional 输入波段索引（从1开始，默认1） default=1 #}
{# @param visible_value integer optional 可见区域像素值（默认255） #}
{# @param invisible_value integer optional 不可见区域像素值（默认0） #}
{# @param output_nodata float optional 输出NoData值（无数据区域的像素值） #}
{# @param curvature_coefficient float optional 地球曲率和折射效应系数 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_raster_viewshed

gdal raster viewshed -i {{ input | safe_path | quote }} -o {{ output | safe_path | quote }}{% if of %} -f {{ of | quote }}{% endif %}{% if pos %} -p {{ pos | quote }}{% endif %}{% if height %} -z {{ height | quote }}{% endif %}{% if mode %} --mode {{ mode | quote }}{% endif %}{% if target_height %} --target-height {{ target_height | quote }}{% endif %}{% if max_distance %} --max-distance {{ max_distance | quote }}{% endif %}{% if min_distance %} --min-distance {{ min_distance | quote }}{% endif %}{% if start_angle %} --start-angle {{ start_angle | quote }}{% endif %}{% if end_angle %} --end-angle {{ end_angle | quote }}{% endif %}{% if band %} -b {{ band | quote }}{% endif %}{% if visible_value %} --visible-value {{ visible_value | quote }}{% endif %}{% if invisible_value %} --invisible-value {{ invisible_value | quote }}{% endif %}{% if output_nodata %} --output-nodata {{ output_nodata | quote }}{% endif %}{% if curvature_coefficient %} --curvature-coefficient {{ curvature_coefficient | quote }}{% endif %}

REM Done
