{# @id gdal_compare #}
{# @name 栅格数据集对比 #}
{# @description 比较两个GDAL数据集的像素值和元数据差异，常用于验证数据处理结果 #}
{# @keyword compare #}
{# @keyword diff #}
{# @keyword 对比 #}
{# @keyword 差异 #}
{# @keyword validation #}
{# @keyword pixel #}
{# @keyword raster #}
{# @concept "gdalcompare 是 GDAL 的数据集比较工具，检查两个 GDAL 支持的数据集在像素值、元数据、坐标变换等方面的差异" #}
{# @concept "工具会返回差异计数作为退出值，字节级别的二进制差异会被单独计算，若只需数据本身相同可忽略计数为1的情况" #}
{# @note gdalcompare 是一个 Python 工具，需要 GDAL Python 绑定才能使用 #}
{# @note 差异计数为1通常只表示二进制内容差异，若 GDAL 可视数据相同则可视为一致 #}
{# @common_error "Unable to open datasource" — 指定的文件路径不存在或文件格式不被 GDAL 支持 #}
{# @common_error "Different pixel values" — 两个数据集的像素内容存在差异，可使用 dumpdiffs 查看具体差异分布 #}
{# @param golden_file file_path required 参考文件（金标准文件），被认为是正确的数据集 #}
{# @param new_file file_path required 待比较的新文件，与金标准文件进行对比 #}
{# @param dumpdiffs boolean optional 将像素差异内容输出为当前目录下的TIFF文件 #}
{# @param skip_binary boolean optional 跳过二进制内容的精确比较，忽略时差异计数为1表示数据一致 #}
{# @param skip_overviews boolean optional 跳过概视图（overviews）的比较 #}
{# @param skip_metadata boolean optional 跳过元数据的比较 #}
{# @param sds boolean optional 比较数据集中的所有子数据集 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_compare

gdalcompare{% if dumpdiffs %} -dumpdiffs{% endif %}{% if skip_binary %} -skip_binary{% endif %}{% if skip_overviews %} -skip_overviews{% endif %}{% if skip_metadata %} -skip_metadata{% endif %}{% if sds %} -sds{% endif %} {{ golden_file | safe_path | quote }} {{ new_file | safe_path | quote }}

REM Done
