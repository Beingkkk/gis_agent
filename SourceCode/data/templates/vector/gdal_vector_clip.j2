{# @id gdal_vector_clip #}
{# @name 矢量数据裁剪 #}
{# @description 使用坐标范围、几何图形或模板数据集对矢量数据进行空间裁剪 #}
{# @keyword clip #}
{# @keyword 裁剪 #}
{# @keyword bbox #}
{# @keyword geometry #}
{# @keyword 空间裁剪 #}
{# @keyword crop #}
{# @keyword 范围裁剪 #}
{# @keyword shp #}
{# @concept "gdal vector clip 使用空间坐标范围、几何图形或模板数据集对矢量要素进行裁剪提取" #}
{# @concept "裁剪会自动处理几何类型兼容性问题，将多几何类型拆分为单部件，并提升为多几何类型" #}
{# @note 必须指定 --bbox、--geometry 或 --like 中的一个作为裁剪依据 #}
{# @note 裁剪结果的几何类型会被统一处理：多几何类型会被拆分，单几何类型会被提升为多几何类型 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "At least one of --bbox, --geometry or --like must be specified" — 未指定裁剪方式，需要设置边界框、几何图形或模板数据集 #}
{# @common_error "Mutually exclusive options" — 同时指定了互斥的选项（如同时使用 --bbox 和 --geometry） #}
{# @param input file_path required 输入矢量数据集路径 #}
{# @param output file_path required 输出矢量数据集路径 #}
{# @param bbox string optional 裁剪边界框，格式为 xmin,ymin,xmax,ymax（如 100,30,120,50） #}
{# @param bbox_crs crs optional 边界框的坐标参考系统定义（如 EPSG:4326） #}
{# @param geometry text optional 裁剪几何图形（WKT 或 GeoJSON 格式的空间几何） #}
{# @param geometry_crs crs optional 几何图形的坐标参考系统定义 #}
{# @param like file_path optional 用作裁剪范围的模板数据集（使用该数据集的范围作为裁剪边界） #}
{# @param layer string optional 输入图层名称（可指定多个） #}
{# @param of format optional 输出格式名称 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML #}
{# @param output_layer string optional 输出图层名称 #}
{# @param like_layer string optional 模板数据集中用作裁剪范围的图层名称 #}
{# @param append boolean optional 追加到现有图层 #}
{# @param overwrite boolean optional 覆盖已存在的输出数据集 #}

