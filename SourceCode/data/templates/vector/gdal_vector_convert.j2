{# @id gdal_vector_convert #}
{# @name GDAL矢量数据格式转换 #}
{# @description 使用 gdal vector convert 命令在不同矢量格式之间转换数据，支持多种创建和写入选项 #}
{# @keyword gdal #}
{# @keyword vector #}
{# @keyword convert #}
{# @keyword 格式转换 #}
{# @keyword shp #}
{# @keyword geojson #}
{# @keyword gpkg #}
{# @keyword 转换 #}
{# @concept "gdal vector convert 是 GDAL 3.x 新引入的矢量转换命令，提供更统一的命令行接口" #}
{# @concept "支持创建选项(co/lco)控制输出格式的具体参数，如Shapefile的编码、GPKG的压缩等" #}
{# @note append 和 upsert 选项互斥，不能同时使用 #}
{# @note 输入输出格式通常可从文件扩展名自动推断，但显式指定可避免歧义 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Unable to open datasource" — 输入文件路径不存在、格式不支持或权限不足 #}
{# @common_error "Layer not found" — 指定的输入图层名称不存在于数据源中 #}
{# @param input file_path required 输入矢量数据源路径 #}
{# @param output file_path required 输出矢量数据源路径 #}
{# @param of format optional 输出格式名称 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML,SQLite #}
{# @param input_format format optional 输入数据格式 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML,SQLite #}
{# @param layer string optional 输入图层名称 #}
{# @param output_layer string optional 输出图层名称 #}
{# @param co text optional 数据集创建选项（KEY=VALUE 格式） #}
{# @param lco text optional 图层创建选项（KEY=VALUE 格式） #}
{# @param oo text optional 输入数据打开选项（KEY=VALUE 格式） #}
{# @param output_oo text optional 输出数据打开选项（KEY=VALUE 格式） #}
{# @param overwrite boolean optional 允许覆盖已存在的输出数据集 #}
{# @param update boolean optional 以更新模式打开已存在的数据集 #}
{# @param overwrite_layer boolean optional 允许覆盖已存在的输出图层 #}
{# @param append boolean optional 追加到已存在的图层（与upsert互斥） #}
{# @param upsert boolean optional Upsert要素（隐含append，与append互斥） #}
{# @param skip_errors boolean optional 写入要素时跳过错误 #}
{# @param no_create_empty_layers boolean optional 避免创建没有任何要素的图层 #}

