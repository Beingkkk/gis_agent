{# @id gdal_mdim_info #}
{# @name 多维数据信息查询 #}
{# @description 查询 GDAL 多维栅格数据集的结构信息，包括组层级、数组维度、数据类型和属性等 #}
{# @keyword netcdf #}
{# @keyword zarr #}
{# @keyword hdf5 #}
{# @keyword multidimensional #}
{# @keyword 多维 #}
{# @keyword nc #}
{# @keyword 信息查询 #}
{# @keyword gdalmdim #}
{# @concept "多维数据集（Multidimensional Dataset）是指包含多个维度的栅格数据，常见于气象、海洋、科学研究等领域，如 NetCDF、Zarr、HDF5 格式" #}
{# @concept "gdal mdim info 以 JSON 格式输出数据集的完整结构信息，包括组层级、数组定义、维度大小、数据类型和属性等" #}
{# @note --summary 和 --detailed 互斥，不能同时使用 #}
{# @note 该工具为只读查询命令，不生成输出文件，结果直接输出到标准输出 #}
{# @common_error "ERROR 1: Not a multidimensional file" — 指定的文件不是 GDAL 支持的多维数据格式，可能需要检查文件扩展名或使用 --input-format 指定格式 #}
{# @common_error "Failed to open dataset" — 文件路径不存在、文件损坏或缺少必要的驱动支持 #}
{# @param input file_path required 输入多维栅格数据集路径（支持 NetCDF、Zarr、HDF5 等格式） #}
{# @param summary boolean optional 仅报告组和数组层级结构，不包含属性和维度的详细信息 #}
{# @param detailed boolean optional 最详细输出，包含属性数据类型和数组值 #}
{# @param array string optional 指定数组名称，仅输出该数组的详细信息 #}
{# @param limit integer optional 限制每个维度显示值的数量 #}
{# @param stats boolean optional 读取并显示图像统计信息 #}
{# @param input_format format optional 指定输入数据格式 options=netCDF,Zarr,HDF5,MEM #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_mdim_info

gdal mdim info{% if summary %} --summary{% endif %}{% if detailed %} --detailed{% endif %}{% if stats %} --stats{% endif %}{% if array %} --array {{ array | quote }}{% endif %}{% if limit %} --limit {{ limit | quote }}{% endif %}{% if input_format %} --input-format {{ input_format | quote }}{% endif %} {{ input | safe_path | quote }}

REM Done
