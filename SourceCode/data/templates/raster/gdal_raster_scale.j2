{# @id gdal_raster_scale #}
{# @name 栅格像素值缩放 #}
{# @description 对栅格图像的像素值进行线性或非线性缩放重映射，支持指定输入输出范围和数据类型转换 #}
{# @keyword scale #}
{# @keyword rescale #}
{# @keyword pixel #}
{# @keyword normalize #}
{# @keyword stretch #}
{# @keyword 栅格 #}
{# @keyword 像素 #}
{# @keyword 缩放 #}
{# @keyword 归一化 #}
{# @keyword 重映射 #}
{# @concept "像素值缩放将输入栅格的值从 [input-min, input-max] 区间线性映射到 [output-min, output-max] 区间，常用于数据归一化或灰度拉伸增强" #}
{# @concept "幂函数缩放通过 exponent 参数实现非线性对比度增强，exponent>1 增强亮部，exponent<1 增强暗部" #}
{# @note 默认会裁剪超出指定输入范围的像素值，使用 --no-clip 可保留原始值 #}
{# @note 如果不指定输入范围，系统会自动计算；若多次使用建议先运行 gdal raster edit --stats 预计算统计值以提升性能 #}
{# @seealso gdal_raster_unscale #}
{# @common_error "Missing value for --input-min" — 指定了 input_min 但未指定 input_max，两者必须同时设置 #}
{# @common_error "output-min must be lower than output-max" — 目标范围最小值必须小于最大值，请检查 output_min 和 output_max 参数 #}
{# @param input file_path required 输入栅格文件路径 #}
{# @param output file_path required 输出栅格文件路径 #}
{# @param of format optional 输出格式名称 options=GTiff,COG,JPEG,PNG,HFA,ENVI,VRT #}
{# @param ot enum optional 输出数据类型 options=UInt8,Int8,UInt16,Int16,UInt32,Int32,UInt64,Int64,Float32,Float64 #}
{# @param band integer optional 指定要缩放的波段（从1开始的索引），默认为所有波段 #}
{# @param input_min float optional 源数据范围的最小值，与 input_max 配对使用 #}
{# @param input_max float optional 源数据范围的最大值，与 input_min 配对使用 #}
{# @param output_min float optional 目标数据范围的最小值，与 output_max 配对使用 #}
{# @param output_max float optional 目标数据范围的最大值，与 output_min 配对使用 #}
{# @param exponent float optional 幂函数非线性缩放的指数值，大于1增强高值，小于1增强低值 #}
{# @param no_clip boolean optional 不裁剪超出输入范围的像素值 #}
{# @param overwrite boolean optional 允许覆盖已存在的输出文件 #}
{# @param append boolean optional 作为子数据集追加到现有文件 #}

