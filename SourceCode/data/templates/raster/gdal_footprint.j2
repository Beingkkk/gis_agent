{# @param ovr integer optional 使用概览级别（0-based索引，如 0 为第一个概览层） #}
{# @param srcnodata string optional 手动指定nodata值（多个波段用空格分隔） #}
{# @param t_cs enum optional 目标坐标系统 options=pixel,georef #}
{# @param t_srs crs optional 输出坐标参考系统（如 EPSG:4326） #}
{# @param split_polys boolean optional 将多部件多边形拆分为多个单部件要素 #}
{# @param convex_hull boolean optional 计算多边形的凸包 #}
{# @param densify float optional 输出几何中相邻两点最大距离（像素或地理单位） #}
{# @param simplify float optional 简化几何的容差值 #}
{# @param min_ring_area float optional 最小多边形面积阈值，小于此值的多边形将被忽略 #}
{# @param max_points string optional 单个要素的最大顶点数（设为 unlimited 则无限制） #}
{# @param lyr_name string optional 输出图层名称 #}
{# @param overwrite boolean optional 覆盖已存在的输出文件 #}
{# @param location_field_name string optional 在输出矢量中存储源栅格路径的字段名 #}
{# @param no_location boolean optional 不将源栅格路径写入输出矢量 #}
{# @param write_absolute_path boolean optional 存储源栅格路径时使用绝对路径 #}
{# @param lco text optional 图层创建选项（KEY=VALUE 格式） #}
{# @param dsco text optional 数据集创建选项（KEY=VALUE 格式） #}
{# @param quiet boolean optional 静默模式，不输出进度信息 #}

