{# @id gdal_config #}
{# @name GDAL配置信息查询 #}
{# @description 查询 GDAL 库的安装配置信息，包括版本、路径、库链接参数和已支持的格式 #}
{# @keyword gdal-config #}
{# @keyword version #}
{# @keyword prefix #}
{# @keyword libs #}
{# @keyword cflags #}
{# @keyword configure #}
{# @keyword installation #}
{# @keyword ogr-enabled #}
{# @keyword formats #}
{# @concept "gdal-config 是一个 Unix 系统下的配置查询脚本，主要供应用程序的 configure 脚本调用，用于获取 GDAL 库的编译和链接参数" #}
{# @concept "该工具不执行数据处理操作，而是输出系统环境和库配置信息" #}
{# @note gdal-config 仅适用于 Unix/Linux 系统，Windows 系统不可用 #}
{# @note 在编译依赖 GDAL 的程序时，常配合 pkg-config 使用 gdal-config 获取所需参数 #}
{# @common_error "command not found" — gdal-config 未安装或不在系统 PATH 环境变量中 #}
{# @common_error "no output or empty output" — GDAL 库未正确安装，或环境变量配置有问题 #}
{# @param prefix folder_path optional GDAL 安装的顶层目录路径 #}
{# @param libs boolean optional 输出 GDAL 库和链接参数 #}
{# @param cflags boolean optional 输出编译 GDAL 模块所需的头文件和宏定义 #}
{# @param version boolean optional 输出 GDAL 版本号 #}
{# @param ogr_enabled boolean optional 检查 OGR 功能是否已集成到 GDAL 中 #}
{# @param formats boolean optional 列出 GDAL 已配置支持的所有格式 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_config

gdal-config{% if prefix %} --prefix={{ prefix | quote }}{% endif %}{% if libs %} --libs{% endif %}{% if cflags %} --cflags{% endif %}{% if version %} --version{% endif %}{% if ogr_enabled %} --ogr-enabled{% endif %}{% if formats %} --formats{% endif %}

REM Done
