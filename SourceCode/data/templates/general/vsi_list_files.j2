{# @id vsi_list_files #}
{# @name 虚拟文件系统文件列表 #}
{# @description 列出 GDAL 虚拟文件系统中的文件和目录，支持压缩文件、网络存储等 #}
{# @keyword vsi #}
{# @keyword vsimem #}
{# @keyword vsizip #}
{# @keyword vsicurl #}
{# @keyword ls #}
{# @keyword list #}
{# @keyword 文件列表 #}
{# @keyword 虚拟文件系统 #}
{# @concept "GDAL 虚拟文件系统 (VSI) 是一种统一的文件访问接口，可透明处理本地文件、内存文件(/vsimem)、压缩文件(/vsizip, /vsitar)及网络文件(/vsicurl)等" #}
{# @concept "通过 vsi 路径前缀，可以像访问本地文件一样访问 ZIP 压缩包内资源、云存储等远程数据" #}
{# @note 默认输出 JSON 格式，便于程序解析；使用 -f text 可切换为文本格式 #}
{# @note 处理压缩包内文件时，路径格式为 /vsizip/xxx.zip/path/inside #}
{# @common_error "ERROR 1: No such file or directory" — 指定的 VSI 路径不存在，可能是压缩包内路径错误或文件已被删除 #}
{# @common_error "ERROR 1:File not found" — 文件名拼写错误，或访问的网络资源不可达 #}
{# @param filename file_path required 虚拟文件系统中的文件或目录路径（如 /vsimem/, /vsizip/test.zip） #}
{# @param of enum optional 输出格式 default=json options=json,text #}
{# @param long_listing boolean optional 使用长列表格式显示文件详细信息（类似 UNIX ls -l） #}
{# @param recursive boolean optional 递归列出所有子目录内容 #}
{# @param depth integer optional 递归的最大深度层级数 #}
{# @param absolute_path boolean optional 显示文件绝对路径而非相对路径 #}
{# @param tree boolean optional 以树形层次结构展示 JSON 输出结果 #}

@echo off
REM Generated by GIS Agent
REM Template: vsi_list_files

gdal vsi list{% if recursive %} -R{% endif %}{% if depth %} --depth {{ depth }}{% endif %}{% if of %} -f {{ of | quote }}{% endif %}{% if long_listing %} -l{% endif %}{% if absolute_path %} --abs{% endif %}{% if tree %} --tree{% endif %} {{ filename | quote }}

REM Done
