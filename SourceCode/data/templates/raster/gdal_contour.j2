{# @common_error "Failed to open datasource" — 输入的DEM栅格文件不存在或路径无效，检查文件是否可读 #}
{# @common_error "Neither -i, -fl or -e specified" — 必须指定等高线高程间隔方式（-i 间隔、-fl 固定级别、-e 指数级别三选一） #}
{# @param input file_path required 输入的DEM栅格文件路径（源数据集） #}
{# @param output file_path required 输出的等高线矢量文件路径（目标数据集） #}
{# @param interval float optional 等高线高程间隔（如 10 表示每隔10个高程单位提取一条等高线） #}
{# @param fixed_levels string optional 指定要提取的固定高程值列表（用空格分隔，如 "100 200 300"） #}
{# @param exp_base float optional 指数间隔底数，生成等比数列高程（如 2 生成 ...50 100 200...） #}
{# @param offset float optional 高程偏移量，从零开始计算间隔的偏移值 #}
{# @param attribute_name string optional 输出矢量中存储高程值的属性字段名称，默认无高程属性 #}
{# @param band integer optional 从输入栅格中读取高程数据的波段号 default=1 #}
{# @param output_format format optional 输出矢量格式 options=ESRI Shapefile,GeoJSON,GPKG,KML,GML #}
{# @param polygon_mode boolean optional 生成等高面多边形而非等高线（用于区域高程范围表示） #}
{# @param force_3d boolean optional 强制生成三维矢量，包含每个顶点的高程值 #}
{# @param nodata float optional 视为无效值的栅格像素值 #}
{# @param inodata boolean optional 忽略输入数据中的nodata值，将所有像元视为有效数据 #}
{# @param layer_name string optional 输出图层的名称 default=contour #}

