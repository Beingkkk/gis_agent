{# @param input file_path required 要验证的COG数据集文件路径 #}
{# @param full_check enum optional 是否执行完整检查 default=auto options=auto,yes,no #}
{# @param config string optional GDAL配置选项，格式为 KEY=VALUE，可重复使用 #}
{# @param quiet boolean optional 静默模式，不显示进度条或警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_cog_validate

gdal driver cog validate{% if full_check %} --full-check {{ full_check | quote }}{% endif %}{% if config %} --config {{ config | quote }}{% endif %}{% if quiet %} -q{% endif %} {{ input | safe_path | quote }}

