{# @id ogrlineref #}
{# @name 线性参照创建与查询 #}
{# @description 用于创建线性参照系统文件，支持沿线的位置查询、坐标提取和线段截取 #}
{# @keyword 线性参照 #}
{# @keyword lrs #}
{# @keyword 里程 #}
{# @keyword 道路 #}
{# @keyword 路径 #}
{# @keyword 参考点 #}
{# @keyword 线性分段 #}
{# @concept "线性参照（LRS）是GIS中一种沿路径定位的方法，通过沿线的距离值来描述位置，常用于交通管理（道路里程）、管网管理（管道桩号）等场景" #}
{# @concept "ogrlineref 创建的参照文件将线要素按固定步长离散化为线段，每个线段记录其起止距离，可实现坐标与里程的相互转换" #}
{# @note 创建线性参照文件需要两条数据：源线图层（定义路径几何）和参照点图层（定义里程基准），通常需要指定关联字段使两者对应 #}
{# @note 该工具不依赖线的 M/Z 坐标值，所有位置信息存储在属性表中 #}
{# @seealso ogr2ogr_convert #}
{# @seealso gdal_proximity #}
{# @seealso gdal_nearblack #}
{# @common_error "Unable to open datasource" — 指定的源数据路径不存在或格式不被支持 #}
{# @common_error "Reference distance out of range" — 查询的距离值超出参照文件的有效范围（最小/最大里程） #}
{# @param create boolean optional 创建模式：生成线性参照文件 #}
{# @param output file_path optional 输出线性参照文件路径 #}
{# @param ref file_path optional 已存在的线性参照文件路径（用于查询操作） #}
{# @param l file_path optional 源线数据源路径（如道路中心线） #}
{# @param lf string optional 用于区分不同线要素的唯一字段名（如道路ID） #}
{# @param p file_path optional 参照点数据源路径（如里程碑点） #}
{# @param pm string optional 沿路径的距离字段名（如里程值） #}
{# @param pf string optional 将参照点映射到线要素的关联字段名 #}
{# @param step float optional 线性参照分段长度（如 1000 表示 1km） #}
{# @param get_pos boolean optional 查询模式：根据输入坐标返回线性参照距离 #}
{# @param x float optional 输入点的X坐标（与 -get_pos 配合使用） #}
{# @param y float optional 输入点的Y坐标（与 -get_pos 配合使用） #}
{# @param get_coord boolean optional 查询模式：根据线性参照距离返回坐标点 #}
{# @param m float optional 输入的线性参照距离值（与 -get_coord 配合使用） #}
{# @param get_subline boolean optional 查询模式：返回指定起止距离间的线段 #}
{# @param mb float optional 线段起始距离（与 -get_subline 配合使用） #}
{# @param me float optional 线段结束距离（与 -get_subline 配合使用） #}
{# @param of format optional 输出格式 default=ESRI Shapefile options=ESRI Shapefile,GeoJSON,GPKG,KML,GML #}
{# @param quiet boolean optional 静默模式：抑制进度信息输出 #}

@echo off
REM Generated by GIS Agent
REM Template: ogrlineref

ogrlineref{% if create %} -create{% endif %}{% if output %} -o {{ output | safe_path | quote }}{% endif %}{% if step %} -s {{ step }}{% endif %}{% if l %} -l {{ l | safe_path | quote }}{% endif %}{% if lf %} -lf {{ lf | quote }}{% endif %}{% if p %} -p {{ p | safe_path | quote }}{% endif %}{% if pm %} -pm {{ pm | quote }}{% endif %}{% if pf %} -pf {{ pf | quote }}{% endif %}{% if ref %} -r {{ ref | safe_path | quote }}{% endif %}{% if get_pos %} -get_pos -x {{ x }} -y {{ y }}{% endif %}{% if get_coord %} -get_coord -m {{ m }}{% endif %}{% if get_subline %} -get_subline -mb {{ mb }} -me {{ me }}{% endif %}{% if of %} -of {{ of | quote }}{% endif %}{% if quiet %} -quiet{% endif %}

