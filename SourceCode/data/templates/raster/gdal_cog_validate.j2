{# @id gdal_cog_validate #}
{# @name 云优化GeoTIFF验证 #}
{# @description 验证GeoTIFF文件是否符合云优化GeoTIFF (COG) 规范 #}
{# @keyword COG #}
{# @keyword Cloud Optimized GeoTIFF #}
{# @keyword GeoTIFF #}
{# @keyword TIFF #}
{# @keyword validate #}
{# @keyword 验证 #}
{# @keyword 云优化 #}
{# @concept "云优化GeoTIFF (Cloud Optimized GeoTIFF, COG) 是一种特殊格式的GeoTIFF文件，针对云端访问进行了优化，可支持大文件的高效分块读取" #}
{# @concept "该工具通过检查TIFF文件的内部结构、空间索引和元数据来判断文件是否符合COG规范" #}
{# @note 此工具需要 GDAL Python 绑定才能正常运行 #}
{# @note 完整检查(auto模式)会根据文件大小自动决定检查深度 #}
{# @common_error "not a valid COG" — 指定的TIFF文件不符合云优化GeoTIFF规范，可能缺少必要的结构化信息 #}
