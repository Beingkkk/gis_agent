{# @id dwg_read_convert #}
{# @name DWG文件读取与转换 #}
{# @description 读取 AutoCAD DWG 格式文件并通过 ogr2ogr 转换为其他矢量格式，支持块引用和属性配置 #}
{# @category vector #}
{# @keyword dwg #}
{# @keyword autocad #}
{# @keyword cad #}
{# @keyword dxf #}
{# @keyword 读取 #}
{# @keyword 格式转换 #}
{# @keyword 块引用 #}
{# @keyword teigha #}
{# @concept "DWG 是 AutoCAD 的二进制工作格式，通过 Open Design Alliance Teigha 库由 OGR 读取，整个文件内容在 OGR 中表示为名为 entities 的单个图层" #}
{# @concept "可通过 --config 配置选项控制块引用展开、块属性处理和闭合线转多边形等行为" #}
{# @note DWG 文件本身不包含地理参考信息，如需在 GIS 中正确定位需使用 -s_srs 手动指定源坐标系 #}
{# @note GDAL 读取 DWG 必须在编译时链接 Open Design Alliance Teigha 库，否则该驱动不可用 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "DWG driver not found / DWG not supported" — 当前 GDAL 构建未包含 ODA Teigha 库支持，需要使用支持 DWG 的 GDAL 版本 #}
{# @common_error "Unable to open DWG file / Unsupported DWG version" — DWG 文件版本超出 ODA Teigha 库支持范围，或文件已损坏；可尝试将其先用 AutoCAD 另存为较低版本 #}
{# @param input file_path required 输入 DWG 文件路径 #}
{# @param output file_path required 输出矢量文件路径 #}
{# @param of format optional 输出格式名称 default=GeoJSON options=GeoJSON,ESRI Shapefile,GPKG,KML,MapInfo File,CSV #}
{# @param t_srs crs optional 目标空间参考系统（如 EPSG:4326），用于坐标转换 #}
{# @param s_srs crs optional 源数据空间参考系统（DWG 无内建地理参考，需手动指定） #}
{# @param inline_blocks boolean optional 是否将块引用展开为块几何（设为 false 时保留引用并提供 blocks 图层） default=True #}
{# @param attributes boolean optional 是否将块属性作为要素字段处理（便于转为表格/数据库行数据） #}
{# @param closed_line_as_polygon boolean optional 是否将闭合的 POLYLINE/LWPOLYLINE 暴露为 OGR 多边形（需 GDAL >= 3.10） #}

@echo off
REM Generated by GIS Agent
REM Template: dwg_read_convert

ogr2ogr{% if of %} -f {{ of | quote }}{% endif %}{% if t_srs %} -t_srs {{ t_srs | quote }}{% endif %}{% if s_srs %} -s_srs {{ s_srs | quote }}{% endif %}{% if inline_blocks == false %} --config DWG_INLINE_BLOCKS FALSE{% endif %}{% if attributes %} --config DWG_ATTRIBUTES TRUE{% endif %}{% if closed_line_as_polygon %} --config DWG_CLOSED_LINE_AS_POLYGON TRUE{% endif %} {{ output | safe_path | quote }} {{ input | safe_path | quote }}

REM Done
