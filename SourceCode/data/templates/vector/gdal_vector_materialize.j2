gdal vector materialize{% if output %} -o {{ output | quote }}{% endif %}{% if of %} -f {{ of | quote }}{% endif %}{% if co %} --co {{ co | quote }}{% endif %}{% if lco %} --lco {{ lco | quote }}{% endif %}{% if overwrite %} --overwrite{% endif %}

