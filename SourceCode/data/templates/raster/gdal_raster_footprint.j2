{# @id gdal_raster_footprint #}
{# @name 栅格边界轮廓生成 #}
{# @description 根据栅格数据的有效像素范围生成矢量多边形轮廓 #}
{# @keyword shp #}
{# @keyword geojson #}
{# @keyword gpkg #}
{# @keyword kml #}
{# @keyword raster #}
{# @keyword footprint #}
{# @keyword boundary #}
{# @keyword nodata #}
{# @keyword 掩膜 #}
{# @keyword 轮廓 #}
{# @concept "gdal raster footprint 根据栅格的nodata值或掩膜信息，将有效像素区域矢量化为多边形，是提取遥感影像有效范围的常用工具" #}
{# @concept "后处理操作按顺序执行：分割多部分→加密点→重投影→过滤小空洞→凸包→简化→限制点数" #}
{# @note 复杂边界建议使用--densify-distance加密点，避免曲线失真 #}
{# @note 对于有无效值但未设置nodata的影像，可先用gdal raster clean-collar预处理生成正确的掩膜 #}
{# @seealso ogr2ogr_convert #}
{# @seealso gdal_raster_clean_collar #}
{# @common_error "Failed to open datasource" — 输出路径的目录不存在，或指定的输出格式不受支持 #}
{# @common_error "Algorithm aborts" — 输入栅格无法读取，可能是文件损坏或格式不支持，请检查GDAL支持的栅格格式列表 #}
{# @param input file_path required 输入栅格文件路径（可指定多个） #}
{# @param output file_path required 输出矢量文件路径（包含footprint多边形） #}
{# @param of format optional 输出矢量格式 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML,Memory #}
{# @param band integer optional 要处理的栅格波段编号（从1开始，默认处理所有波段） #}
{# @param combine_bands enum optional 多波段时如何组合掩膜 default=union options=union,intersection #}
{# @param convex_hull boolean optional 计算footprint的凸包而非实际边界 #}
{# @param simplify_tolerance float optional 输出几何简化容差（与单位一致） #}
{# @param output_crs crs optional 输出矢量坐标系统（如EPSG:4326） #}
{# @param output_layer string optional 输出图层名称 default=footprint #}
{# @param densify_distance float optional 输出几何点之间的最大距离 #}
{# @param min_ring_area float optional 过滤掉面积小于该值的空洞（与单位一致） #}
{# @param max_points integer optional 每个输出几何的最大点数 default=100 #}
{# @param split_multipolygons boolean optional 将多部分几何拆分为多个单部分要素 #}
{# @param location_field string optional 存储输入栅格路径的字段名 #}
{# @param no_location_field boolean optional 不创建存储输入栅格路径的字段 #}
{# @param absolute_path boolean optional 存储的路径为绝对路径（默认相对路径） #}
{# @param append boolean optional 追加到现有图层 #}
{# @param overwrite boolean optional 覆盖已存在的输出数据集 #}
{# @param co text optional GDAL数据集创建选项（KEY=VALUE格式） #}
{# @param lco text optional 图层创建选项（KEY=VALUE格式） #}
{# @param quiet boolean optional 静默模式，不显示进度条 #}

