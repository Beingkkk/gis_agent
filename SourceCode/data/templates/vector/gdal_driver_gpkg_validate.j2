{# @id gdal_driver_gpkg_validate #}
{# @name GeoPackage 规范验证 #}
{# @description 验证 GeoPackage 数据集是否符合 GeoPackage 规范标准 #}
{# @keyword gpkg #}
{# @keyword geopackage #}
{# @keyword validate #}
{# @keyword 验证 #}
{# @keyword 规范 #}
{# @keyword sqlite #}
{# @keyword 合规性 #}
{# @concept "GeoPackage 是一种基于 SQLite 数据库的开放地理信息容器格式，可存储矢量、栅格和瓦片数据" #}
{# @concept "该工具检查数据集的结构、元数据和内容是否符合 OGC GeoPackage 规范要求" #}
{# @note 此工具需要 GDAL Python 绑定才能正常运行 #}
{# @note 详细模式会显示每个检查项的具体结果，便于定位问题 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "GDAL Python bindings not available" — 未安装 GDAL Python 绑定，需要通过 pip install gdal 或相应系统包安装 #}
{# @common_error "Dataset is not a valid GeoPackage" — 指定的文件不是有效的 GeoPackage 格式，可能已损坏或不是 GPKG 文件 #}
{# @param dataset file_path required 要验证的 GeoPackage 数据集文件路径 #}
{# @param full_check boolean optional 是否执行完整检查（包括所有表和扩展的详细验证） #}
{# @param verbose boolean optional 启用详细输出模式，显示更多信息 #}
{# @param quiet boolean optional 静默模式，不显示进度条和警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_driver_gpkg_validate

gdal driver gpkg validate{% if full_check %} --full-check{% endif %}{% if verbose %} -v{% endif %}{% if quiet %} -q{% endif %} {{ dataset | quote }}

