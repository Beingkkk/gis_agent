{# @id gdal_gti_create #}
{# @name 栅格瓦片索引创建 #}
{# @description 使用 gdal driver gti create 创建栅格数据集的矢量索引，用于GDAL瓦片索引驱动 #}
{# @keyword gti #}
{# @keyword tile index #}
{# @keyword raster index #}
{# @keyword vrt #}
{# @keyword mosaic #}
{# @keyword 瓦片 #}
{# @keyword 镶嵌 #}
{# @keyword 索引 #}
{# @keyword virtual raster #}
{# @concept "GTI (GDAL Tile Index) 是一种矢量索引格式，用于管理多个栅格瓦片并通过GDAL GTI驱动进行虚拟镶嵌浏览" #}
{# @concept "gdal driver gti create 会为每个输入栅格创建一条记录，包含文件路径和多边形几何范围，可用于构建金字塔式瓦片服务" #}
{# @note 建议同时设置 --resolution 和 --ot 参数，避免GTI驱动通过打开第一个瓦片来推断这些属性 #}
{# @note 如果输入栅格具有不同的坐标系，必须通过 --output-crs 指定统一的输出坐标系 #}
{# @common_error "Unable to open datasource" — 输入栅格文件路径不存在或无法读取，可能文件格式GDAL不支持 #}
{# @common_error "Tile index extent is not defined in a single CRS" — 输入栅格具有不同的坐标系但未通过 --output-crs 指定统一坐标系，GTI要求所有瓦片使用同一CRS #}
{# @param input file_path required 输入栅格文件路径（支持多个文件） #}
{# @param output file_path required 输出矢量索引文件路径 #}
{# @param of format optional 输出矢量格式 default=GeoJSON options=GeoJSON,GPKG,FlatGeoBuf,ESRI Shapefile,GML #}
{# @param output_crs crs optional 输出坐标参考系统定义（如 EPSG:4326） #}
{# @param recursive boolean optional 递归扫描输入目录下的所有栅格文件 #}
{# @param nln string optional 输出图层的名称 #}
{# @param overwrite boolean optional 允许覆盖已存在的输出数据集 #}
{# @param profile enum optional 输出数据集的配置文件 default=none options=none,STAC-GeoParquet #}
{# @param resolution string optional 虚拟镶嵌的分辨率（格式：xres,yres） #}
{# @param ot enum optional 虚拟镶嵌的数据类型 options=UInt8,Int8,UInt16,Int16,UInt32,Int32,UInt64,Int64,Float16,Float32,Float64,CInt16,CInt32,CFloat32,CFloat64 #}
{# @param nodata string optional 波段的无数据值 #}
{# @param min_pixel_size float optional 最小像素尺寸（地理范围/像素），用于筛选栅格 #}
{# @param max_pixel_size float optional 最大像素尺寸（地理范围/像素），用于筛选栅格 #}
{# @param skip_errors boolean optional 跳过处理过程中出现的错误 #}
{# @param absolute_path boolean optional 将栅格路径存储为绝对路径 #}
{# @param bbox string optional 虚拟镶嵌的边界框（格式：minx,miny,maxx,maxy） #}
{# @param metadata text optional 数据集元数据项（格式：KEY=VALUE，可重复） #}
{# @param input_file boolean optional (auto-completed) #}
{# @param m boolean optional (auto-completed) #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_gti_create

gdal driver gti create{% if of %} -f {{ of | quote }}{% endif %}{% for input_file in input %} {{ input_file | safe_path | quote }}{% endfor %} {{ output | safe_path | quote }}{% if nln %} --nln {{ nln | quote }}{% endif %}{% if output_crs %} --output-crs {{ output_crs | quote }}{% endif %}{% if recursive %} --recursive{% endif %}{% if overwrite %} --overwrite{% endif %}{% if profile and profile != 'none' %} --profile {{ profile | quote }}{% endif %}{% if resolution %} --resolution {{ resolution | quote }}{% endif %}{% if ot %} --ot {{ ot | quote }}{% endif %}{% if nodata %} --nodata {{ nodata | quote }}{% endif %}{% if min_pixel_size %} --min-pixel-size {{ min_pixel_size }}{% endif %}{% if max_pixel_size %} --max-pixel-size {{ max_pixel_size }}{% endif %}{% if skip_errors %} --skip-errors{% endif %}{% if absolute_path %} --absolute-path{% endif %}{% if bbox %} --bbox {{ bbox | quote }}{% endif %}{% if metadata %}{% for m in metadata %} --metadata {{ m | quote }}{% endfor %}{% endif %}

