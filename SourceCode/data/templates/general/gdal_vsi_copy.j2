{# @id gdal_vsi_copy #}
{# @name VSI虚拟文件系统文件复制 #}
{# @description 在GDAL虚拟文件系统中复制文件和目录，支持压缩文件、网络文件等操作 #}
{# @keyword vsi #}
{# @keyword vsimem #}
{# @keyword vsizip #}
{# @keyword vsicurl #}
{# @keyword vsitar #}
{# @keyword 文件复制 #}
{# @keyword 虚拟文件 #}
{# @keyword 拷贝 #}
{# @concept "GDAL虚拟文件系统(VSI)是一种统一的文件访问接口，可处理本地文件、内存文件(/vsimem)、压缩文件(/vsizip, /vsitar)、网络文件(/vsicurl)等多种来源的文件" #}
{# @concept "gdal vsi copy 命令相当于UNIX的cp命令，但可以跨不同虚拟文件系统进行文件复制" #}
{# @note 支持在不同的VSI虚拟文件系统之间复制文件，例如从/vsicurl/网络资源复制到/vsimem/内存文件系统 #}
{# @note 递归选项(-r)用于复制整个目录树结构 #}
{# @common_error "Unable to open source" — 源路径不存在或无法访问，检查VSI路径格式是否正确 #}
{# @common_error "Permission denied" — 目标路径无写入权限，或目标文件系统不支持写入操作 #}
{# @param source file_path required 源文件或目录路径（支持VSI虚拟文件系统路径，如/vsimem/, /vsizip/, /vsicurl/等） #}
{# @param destination file_path required 目标文件或目录路径 #}
{# @param recursive boolean optional 递归复制子目录 #}
{# @param skip_errors boolean optional 跳过错误继续复制 #}
{# @param quiet boolean optional 静默模式，不显示进度条和警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vsi_copy

gdal vsi copy{% if recursive %} -r{% endif %}{% if skip_errors %} --skip-errors{% endif %}{% if quiet %} -q{% endif %} {{ source | quote }} {{ destination | quote }}

REM Done
