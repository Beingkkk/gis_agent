{# @id ogrmerge_merge #}
{# @name 多矢量数据合并 #}
{# @description 使用 ogrmerge 将多个矢量数据集或图层合并为一个输出文件，支持单层合并和多层分离模式 #}
{# @keyword merge #}
{# @keyword concat #}
{# @keyword combine #}
{# @keyword vrt #}
{# @keyword shp #}
{# @keyword geojson #}
{# @keyword gpkg #}
{# @keyword 合并 #}
{# @keyword 拼接 #}
{# @concept "ogrmerge 是 GDAL 的矢量合并工具，可将多个矢量数据集的图层合并到一个目标数据源中" #}
{# @concept "默认模式下每个输入图层的几何和属性结构独立保留；-single 模式会将所有内容追加到单一图层，要求源图层结构相似" #}
{# @note ogrmerge 内部生成 VRT 虚拟格式文件，然后调用 ogr2ogr 完成最终转换 #}
{# @note 对于高级用途，可以先输出 VRT 格式，手动编辑后再用 ogr2ogr 转换 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Unable to open datasource" — 输入数据源路径不存在或格式不支持，请检查文件是否损坏 #}
{# @common_error "Schema mismatch between layers" — 在 -single 模式下，源图层之间的字段定义差异较大，合并可能导致数据丢失或错误 #}
{# @param output file_path required 输出数据集名称（目标文件路径或数据源） #}
{# @param sources string required 一个或多个输入矢量数据源路径（空格分隔） #}
{# @param of format optional 输出格式名称 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML,SQLite #}
{# @param single boolean optional 将所有输入图层合并为单个图层（默认按层分离） #}
{# @param nln string optional 输出图层名称模板，默认模式下可用 {DS_BASENAME}_{LAYER_NAME} 等变量 #}
{# @param s_srs crs optional 源空间参考系统定义（如 EPSG:4326） #}
{# @param t_srs crs optional 目标空间参考系统定义，用于坐标转换 #}
{# @param append boolean optional 追加到已存在的图层（需配合 -update 使用） #}
{# @param overwrite_ds boolean optional 如果目标数据集已存在则覆盖 #}
{# @param progress boolean optional 显示进度条 #}

@echo off
REM Generated by GIS Agent
REM Template: ogrmerge_merge

ogrmerge -o {{ output | quote }}{% if sources %} {{ sources | quote }}{% endif %}{% if of %} -f {{ of | quote }}{% endif %}{% if single %} -single{% endif %}{% if nln %} -nln {{ nln | quote }}{% endif %}{% if s_srs %} -s_srs {{ s_srs | quote }}{% endif %}{% if t_srs %} -t_srs {{ t_srs | quote }}{% endif %}{% if append %} -append{% endif %}{% if overwrite_ds %} -overwrite_ds{% endif %}{% if progress %} -progress{% endif %}

REM Done
