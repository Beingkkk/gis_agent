{# @id gdalmove_transform #}
{# @name 栅格坐标系统转换 #}
{# @description 在不重采样像素的情况下转换栅格文件坐标系统和边界信息 #}
{# @keyword 栅格 #}
{# @keyword 坐标转换 #}
{# @keyword 投影变换 #}
{# @keyword geotransform #}
{# @keyword 重投影 #}
{# @keyword reproject #}
{# @concept "gdalmove 仅转换栅格文件的坐标系统和边界元数据，不对像素值做任何重采样，避免了 gdalwarp 重采样带来的图像质量损失" #}
{# @concept "该工具只适用于在文件范围内近似线性的坐标变换，对于需要多项式拟合的非线性变换可能产生较大误差" #}
{# @note 如果不指定 -et 参数，工具只会报告误差而不会实际修改文件，这是一种预览模式 #}
{# @note 仅支持原地更新元数据的栅格格式（如 GeoTIFF），不支持需要创建新文件的格式 #}
{# @seealso gdalwarp_reproject #}
{# @common_error "File format does not support in-place updates" — 目标栅格格式不支持原地修改元数据，应改用 gdalwarp 进行完整重投影并生成新文件 #}
{# @common_error "Exceeds pixel error threshold" — 计算的坐标变换误差超过了指定的 -et 阈值，文件未被更新，可尝试增大阈值或检查输入的坐标系定义是否正确 #}
{# @param target_file file_path required 要进行坐标转换的栅格文件路径（必须是支持原地更新元数据的格式） #}
{# @param t_srs crs required 目标坐标系统定义，将被写入文件（如 EPSG:4326） #}
{# @param s_srs crs optional 源坐标系统定义，如未提供则自动从文件中读取 #}
{# @param et float optional 像素误差阈值，如果计算的误差小于此值才执行更新操作 #}

@echo off
REM Generated by GIS Agent
REM Template: gdalmove_transform

gdalmove{% if s_srs %} -s_srs {{ s_srs | quote }}{% endif %} -t_srs {{ t_srs | quote }}{% if et %} -et {{ et }}{% endif %} {{ target_file | quote }}

REM Done
