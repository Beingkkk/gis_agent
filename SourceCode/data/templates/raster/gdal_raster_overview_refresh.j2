{# @id gdal_raster_overview_refresh #}
{# @name 栅格金字塔刷新 #}
{# @description 刷新栅格数据集的概览（ pyramids 金字塔）图层，提升大数据集的显示渲染性能 #}
{# @keyword overview #}
{# @keyword pyramid #}
{# @keyword resampling #}
{# @keyword 栅格 #}
{# @keyword 金字塔 #}
{# @keyword 重采样 #}
{# @keyword gdal #}
{# @keyword 显示优化 #}
{# @concept "概览（Overview）是栅格数据的多分辨率金字塔，用于加速大比例尺下的显示渲染" #}
{# @concept "当源数据被修改后（如裁剪、重分类），需要刷新概览以同步更新显示效果" #}
{# @note 默认刷新所有概览级别，可通过 --levels 指定要刷新的特定级别 #}
{# @note --bbox 和 --like 互斥，用于限定刷新区域以节省处理时间 #}
{# @common_error "ERROR 1: Failed to find overview" — 指定刷新外部概览但数据源中不存在外部概览文件 #}
{# @common_error "Overview does not exist for level" — 指定的概览级别在数据集中不存在，通常因为数据集创建时未建立该级别的概览 #}
{# @param input file_path required 要刷新概览的栅格数据集路径（默认原地更新） #}
{# @param external boolean optional 刷新外部概览文件（不是嵌入数据集的概览） #}
{# @param resampling enum optional 重采样方法，用于重新计算像素值 options=nearest,average,cubic,cubicspline,lanczos,bilinear,gauss,average_magphase,rms,mode #}
{# @param levels string optional 要刷新的概览级别（如 2,4,8,16），多个值用逗号分隔 #}
{# @param bbox text optional 限定刷新范围的边界框（格式：xmin,ymin,xmax,ymax） #}
{# @param like file_path optional 使用参考数据集的空间范围来限定刷新区域 #}
{# @param use_source_timestamp boolean optional 基于源数据的时间戳判断是否需要刷新（仅适用于 VRT 或 GTI 数据源） #}
{# @param quiet boolean optional 静默模式，不显示进度条和警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_raster_overview_refresh

gdal raster overview refresh{% if input %} {{ input | safe_path | quote }}{% endif %}{% if external %} --external{% endif %}{% if resampling %} -r {{ resampling }}{% endif %}{% if levels %} --levels {{ levels | quote }}{% endif %}{% if bbox %} --bbox {{ bbox | quote }}{% endif %}{% if like %} --like {{ like | quote }}{% endif %}{% if use_source_timestamp %} --use-source-timestamp{% endif %}{% if quiet %} -q{% endif %}

