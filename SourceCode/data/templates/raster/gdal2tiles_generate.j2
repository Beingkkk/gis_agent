{# @id gdal2tiles_generate #}
{# @name 栅格瓦片生成 #}
{# @description 将栅格图像转换为符合OSGeo标准的地图瓦片，生成可发布的Web地图切片 #}
{# @keyword tile #}
{# @keyword tiles #}
{# @keyword xyz #}
{# @keyword tms #}
{# @keyword osm #}
{# @keyword webmap #}
{# @keyword mapcache #}
{# @keyword 瓦片 #}
{# @keyword 切片 #}
{# @keyword 地图 #}
{# @keyword 重采样 #}
{# @concept "gdal2tiles 将栅格数据按金字塔结构切割为小瓦片，生成带有元数据的目录结构，可直接上传至Web服务器发布" #}
{# @concept "支持三种瓦片坐标系：墨卡托(mercator)兼容Google Maps，地理坐标(geodetic)适合全球数据，栅格(raster)适合无投影图像" #}
{# @note 自GDAL 3.13起，gdal2Tiles默认重映射到gdal raster tile，旧版代码需添加--legacy参数 #}
{# @note 输入数据若为非Byte类型（如Int16、UInt16）会自动截断到Byte范围，建议先用gdal_translate转为Byte类型 #}
{# @seealso gdal_translate #}
{# @seealso gdal2ogr_convert #}
{# @common_error "Invalid zoom values" — 指定的缩放级别范围无效，应为"起始-结束"格式且在有效范围内 #}
{# @common_error "Non-Byte data type causes wrong results" — 输入栅格数据类型不是Byte类型（Int16、UInt16等）会导致像素值错误截断，需先用gdal_translate转换数据类型 #}
{# @param input file_path required 输入栅格文件路径（如GeoTIFF、ECW等格式） #}
{# @param output_dir folder_path optional 输出瓦片目录路径，默认为当前目录 #}
{# @param profile enum optional 瓦片切割配置文件类型 default=mercator options=mercator,geodetic,raster #}
{# @param resampling enum optional 重采样方法 default=average options=average,near,bilinear,cubic,cubicspline,lanczos,mode,max,min,med,q1,q3 #}
{# @param s_srs crs optional 源数据空间参考系统定义（如EPSG:4326） #}
{# @param zoom string optional 缩放级别范围，格式为"start-end"（如"2-5"） #}
{# @param xyz boolean optional 生成XYZ格式瓦片（OSM标准），而非TMS格式 #}
{# @param tmscompatible boolean optional 使用地理坐标系时，基础分辨率设为0.703125 #}
{# @param title string optional 生成的Web地图标题 #}
{# @param copyright string optional 地图版权信息 #}
{# @param processes integer optional 并行处理进程数 #}
{# @param nodata string optional 设置无数据值像素 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal2tiles_generate

gdal2tiles{% if profile %} -p {{ profile | quote }}{% endif %}{% if resampling %} -r {{ resampling | quote }}{% endif %}{% if s_srs %} -s {{ s_srs | quote }}{% endif %}{% if zoom %} -z {{ zoom | quote }}{% endif %}{% if xyz %} --xyz{% endif %}{% if tmscompatible %} -d{% endif %}{% if title %} -t {{ title | quote }}{% endif %}{% if copyright %} -c {{ copyright | quote }}{% endif %}{% if processes %} --processes={{ processes }}{% endif %}{% if nodata %} -a {{ nodata | quote }}{% endif %}{{ input | safe_path | quote }}{% if output_dir %} {{ output_dir | safe_path | quote }}{% endif %}

REM Done
