{# @id ogr2ogr_arrow_convert #}
{# @name Arrow IPC格式转换 #}
{# @description 使用 ogr2ogr 将矢量数据与 Apache Arrow IPC (Feather) 格式相互转换，支持 GeoArrow 几何编码 #}
{# @category vector #}
{# @keyword arrow #}
{# @keyword feather #}
{# @keyword ipc #}
{# @keyword geoarrow #}
{# @keyword 格式转换 #}
{# @keyword 矢量转换 #}
{# @concept "Apache Arrow IPC（Feather）是一种跨语言可移植的列式文件格式，GDAL 通过 Arrow 驱动支持其读写，常用于数据科学和 Python/R 生态的数据交换" #}
{# @concept "GeoArrow 是在 Arrow 列式存储中表达矢量几何数据的规范，GDAL 默认使用其 struct 编码方式（点为含 x/y 子字段的 struct，线/面为点的列表）" #}
{# @note Arrow 驱动目前应被视为实验性驱动，因为 GeoArrow 规范尚未最终确定 #}
{# @note 输出文件名以 .arrow 结尾时默认使用 FILE（Feather）格式，以 .arrows 结尾或 /vsistdout/ 时默认使用 STREAM 格式，也可通过 -lco FORMAT 显式指定 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Arrow driver not found / not recognized" — 当前 GDAL 编译时未启用 Apache Arrow C++ 库支持，需通过 conda-forge 安装 libgdal-arrow 插件或重新编译 GDAL 以启用该驱动 #}
{# @common_error "FORMAT=STREAM not supported for /vsimem/" — STREAM 流式格式依赖顺序读写，不支持 /vsimem/ 等需要随机访问的虚拟文件系统，且每个数据集仅支持单个图层 #}
{# @param input file_path required 输入矢量文件路径（源数据集） #}
{# @param output file_path required 输出 Arrow 文件路径（.arrow 为 Feather 文件格式，.arrows 为流式格式） #}
{# @param format_variant enum optional Arrow IPC 格式变体：FILE 为随机访问格式（Feather），STREAM 为流式格式 default=FILE options=FILE,STREAM #}
{# @param compression enum optional 压缩方法，可选值取决于 Arrow 库编译时支持情况 default=LZ4 options=NONE,ZSTD,LZ4 #}
{# @param geometry_encoding enum optional 几何列编码方式，GDAL 3.9+ 默认使用 GeoArrow struct 编码 default=GEOARROW options=GEOARROW,WKB,WKT,GEOARROW_INTERLEAVED #}
{# @param batch_size integer optional 每个 Arrow 记录批次的最大行数 default=65536 #}
{# @param geometry_name string optional 几何列的名称 default=geometry #}
{# @param fid string optional FID（要素标识符）列名称，不指定则不创建 FID 列 #}
{# @param s_srs crs optional 源数据的空间参考系统定义（如 EPSG:4326） #}
{# @param t_srs crs optional 目标空间参考系统定义，用于输出时进行坐标转换（如 EPSG:4326） #}

@echo off
REM Generated by GIS Agent
REM Template: ogr2ogr_arrow_convert

ogr2ogr -f Arrow{% if format_variant %} -lco FORMAT={{ format_variant }}{% endif %}{% if compression %} -lco COMPRESSION={{ compression }}{% endif %}{% if geometry_encoding %} -lco GEOMETRY_ENCODING={{ geometry_encoding }}{% endif %}{% if batch_size %} -lco BATCH_SIZE={{ batch_size }}{% endif %}{% if geometry_name %} -lco GEOMETRY_NAME={{ geometry_name | quote }}{% endif %}{% if fid %} -lco FID={{ fid | quote }}{% endif %}{% if s_srs %} -s_srs {{ s_srs | quote }}{% endif %}{% if t_srs %} -t_srs {{ t_srs | quote }}{% endif %} {{ output | safe_path | quote }} {{ input | safe_path | quote }}

REM Done
