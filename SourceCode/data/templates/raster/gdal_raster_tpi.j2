{# @param output file_path required 输出TPI栅格文件路径 #}
{# @param of format optional 输出格式 default=GTiff options=GTiff,ENVI,HFA,COG #}
{# @param co text optional 创建选项（KEY=VALUE格式），可多次指定 #}
{# @param band integer optional 输入波段序号（从1开始） default=1 #}
{# @param no_edges boolean optional 不对边缘像素进行插值计算，直接设为nodata #}
{# @param overwrite boolean optional 覆盖已存在的输出文件 #}

