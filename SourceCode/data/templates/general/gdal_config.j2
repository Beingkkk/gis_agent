{# @id gdal_config #}
{# @name GDAL配置信息查询 #}
{# @description 查询GDAL库安装路径、编译选项、版本及支持格式等配置信息 #}
{# @keyword gdal-config #}
{# @keyword 编译配置 #}
{# @keyword 安装路径 #}
{# @keyword 版本查询 #}
{# @keyword 格式支持 #}
{# @keyword 开发库 #}
{# @concept "gdal-config 是Unix系统下的GDAL配置查询脚本，主要供开发者在编译应用程序时获取GDAL库的链接路径和编译参数" #}
{# @concept "该工具返回的信息可直接用于Makefile或configure脚本中，自动配置GDAL依赖" #}
{# @note 此工具仅在Unix/Linux系统上可用，Windows系统请使用其他方式查询GDAL配置 #}
{# @note 多个选项可同时使用，例如同时查询版本和支持的格式：gdal-config --version --formats #}
{# @seealso gdalinfo_dataset #}
{# @common_error "command not found: gdal-config" — GDAL未正确安装或未将bin目录加入PATH环境变量 #}
{# @common_error "无输出结果" — 指定的查询选项不正确，或GDAL安装时未包含该选项支持 #}
{# @param version boolean optional 查询GDAL版本号 #}
{# @param libs boolean optional 输出GDAL库及链接参数，用于编译程序 #}
{# @param cflags boolean optional 输出GDAL头文件路径和宏定义，用于编译 #}
{# @param prefix folder_path optional 指定GDAL安装的顶级目录 #}
{# @param ogr_enabled boolean optional 查询是否已编译OGR矢量模块支持 #}
{# @param formats boolean optional 列出GDAL已配置支持的所有驱动格式 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_config

gdal-config{% if version %} --version{% endif %}{% if libs %} --libs{% endif %}{% if cflags %} --cflags{% endif %}{% if prefix %} --prefix={{ prefix | quote }}{% endif %}{% if ogr_enabled %} --ogr-enabled{% endif %}{% if formats %} --formats{% endif %}

REM Done
