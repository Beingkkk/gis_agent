{# @id gdalinfo_raster_info #}
{# @name 栅格数据集信息查询 #}
{# @description 使用 gdalinfo 查看栅格数据集的元数据、统计信息、坐标系统等详细信息 #}
{# @keyword tiff #}
{# @keyword gtiff #}
{# @keyword raster #}
{# @keyword 元数据 #}
{# @keyword 信息查询 #}
{# @keyword 统计信息 #}
{# @keyword gdalininfo #}
{# @concept "gdalinfo 是 GDAL 的栅格信息查看工具，可获取影像的尺寸、波段数、数据类型、坐标系统、元数据、统计信息等详细属性" #}
{# @concept "支持多子数据集格式（如 HDF、NetCDF），通过 -sd 参数指定要查看的子数据集" #}
{# @note 不带任何参数运行会输出数据集的完整信息，包括坐标变换、GCPS、元数据等 #}
{# @note -json 格式输出适合程序化处理，GDAL 3.6+ 版本包含可用于构建 STAC 项目的键值对 #}
{# @common_error "Unable to open datasource" — 输入文件路径不存在或格式不受 GDAL 支持，请检查文件是否存在或使用 -if 指定驱动 #}
{# @common_error "SUBDATASET" — 输入文件包含多个子数据集，需使用 -sd 参数指定要查看的子数据集编号 #}
{# @param dataset file_path required 输入栅格数据集路径（支持 GeoTIFF、HDF、NetCDF 等格式） #}
{# @param json boolean optional 以 JSON 格式输出结果（GDAL 3.6+ 支持 STAC 格式的关键字段） #}
{# @param stats boolean optional 读取并显示图像统计信息，无则强制计算 #}
{# @param approx_stats boolean optional 读取近似统计信息（基于概览或部分数据块） #}
{# @param hist boolean optional 报告所有波段的直方图信息 #}
{# @param mm boolean optional 强制计算每个波段的实际最小值和最大值 #}
{# @param checksum boolean optional 强制计算每个波段的校验和 #}
{# @param proj4 boolean optional 输出 PROJ.4 格式的坐标系统字符串 #}
{# @param wkt_format enum optional WKT 格式版本，用于显示空间参考系统 options=WKT1,WKT1_ESRI,WKT2,WKT2_2015,WKT2_2018,WKT2_2019 #}
{# @param sd integer optional 读取第 n 个子数据集（从 1 开始编号） #}
{# @param nogcp boolean optional 不显示地面控制点列表 #}
{# @param nomd boolean optional 不显示元数据信息 #}
{# @param norat boolean optional 不显示栅格属性表 #}
{# @param noct boolean optional 不显示颜色表 #}
{# @param nonodata boolean optional 不显示 NoData 值（隐含 -nomask） #}
{# @param nomask boolean optional 不显示波段掩码信息 #}
{# @param listmdd boolean optional 列出所有可用的元数据域 #}
{# @param of format optional 指定输出格式 options=GTiff,HFA,JPEG,PNG,MEM,GPKG #}

@echo off
REM Generated by GIS Agent
REM Template: gdalinfo_raster_info

gdalinfo{% if json %} -json{% endif %}{% if mm %} -mm{% endif %}{% if stats %} -stats{% endif %}{% if approx_stats %} -approx_stats{% endif %}{% if hist %} -hist{% endif %}{% if nogcp %} -nogcp{% endif %}{% if nomd %} -nomd{% endif %}{% if norat %} -norat{% endif %}{% if noct %} -noct{% endif %}{% if nonodata %} -nonodata{% endif %}{% if nomask %} -nomask{% endif %}{% if checksum %} -checksum{% endif %}{% if listmdd %} -listmdd{% endif %}{% if proj4 %} -proj4{% endif %}{% if wkt_format %} -wkt_format {{ wkt_format | quote }}{% endif %}{% if sd %} -sd {{ sd }}{% endif %}{% if of %} -of {{ of | quote }}{% endif %} {{ dataset | safe_path | quote }}

