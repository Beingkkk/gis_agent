{# @param srcfile file_path optional 源栅格数据集路径，从中获取源坐标系定义 #}
{# @param dstfile file_path optional 目标文件路径，指定输出结果文件 #}
{# @param s_srs crs optional 源空间参考系统定义（如 EPSG:4326、EPSG:3857 或 PROJ.4 字符串） #}
