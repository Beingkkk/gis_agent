{# @id gdal_raster_edit #}
{# @name 栅格数据集编辑 #}
{# @description 原地编辑栅格数据集的元数据、坐标系、NODATA值、颜色表等属性 #}
{# @keyword gtiff #}
{# @keyword tiff #}
{# @keyword dem #}
{# @keyword 编辑 #}
{# @keyword 元数据 #}
{# @keyword nodata #}
{# @keyword 颜色表 #}
{# @keyword 坐标系 #}
{# @concept "gdal raster edit 是一种原地编辑栅格数据集的工具，可修改元数据、坐标系、NODATA值、颜色表、比例尺偏移等属性" #}
{# @concept "该工具直接修改原始数据文件，不生成新文件，适合批量更新栅格元信息" #}
{# @note 默认情况下直接修改原文件，使用 --auxiliary 可改为编辑对应的 .aux.xml 辅助文件 #}
{# @note --stats 和 --approx-stats 是互斥选项，不能同时使用 #}
{# @common_error "Unable to open datasource" — 指定的栅格文件路径不存在或无法被 GDAL 识别 #}
{# @common_error "Band number out of range" — 指定的波段编号超出数据集实际波段数量范围 #}
{# @param dataset file_path required 要编辑的栅格数据集路径（原地修改） #}
{# @param band integer optional 激活的波段编号（从1开始的索引） #}
{# @param crs crs optional 覆盖数据集的坐标系统定义（不进行重投影） #}
{# @param bbox string optional 设置边界框，格式为 xmin,ymin,xmax,ymax #}
{# @param nodata string optional 为输出波段指定NODATA值（'none'、数值、'nan'、'inf'、'-inf'） #}
{# @param color_interpretation string optional 设置波段颜色解释，如 Gray、Red、Green、Blue、Alpha 等 #}
{# @param color_map file_path optional 颜色表文件路径 #}
{# @param scale string optional 覆盖波段比例因子，格式为 [<BAND>=]<SCALE> #}
{# @param offset string optional 覆盖波段偏移常量，格式为 [<BAND>=]<OFFSET> #}
{# @param metadata string optional 添加或更新数据集元数据项，格式为 KEY=VALUE #}
{# @param unset_color_table boolean optional 取消设置第一个波段或指定波段的颜色表 #}
{# @param stats boolean optional 计算统计信息（使用所有像素） #}
{# @param approx_stats boolean optional 近似计算统计信息（使用子集像素） #}
{# @param histogram boolean optional 计算直方图 #}
{# @param auxiliary boolean optional 编辑辅助的 .aux.xml 文件而不是原始数据 #}

