{# @id gdal_vector_check_geometry #}
{# @name 矢量几何检查 #}
{# @description 使用 GEOS 库检查矢量数据的几何有效性，输出无效几何的错误描述和位置信息 #}
{# @keyword geometry #}
{# @keyword validity #}
{# @keyword check #}
{# @keyword geos #}
{# @keyword polygon #}
{# @keyword linestring #}
{# @keyword 无效几何 #}
{# @keyword 几何验证 #}
{# @concept "gdal vector check-geometry 使用 GEOS 库进行几何有效性检查，与 PostGIS、QGIS、shapely 等软件结果一致" #}
{# @concept "检查范围包括：多边形/MultiPolygon 的有效性、线串/MultiLineString 的简单性（非自相交）、GeometryCollection 各元素的检查" #}
{# @note 弯曲几何会被线性化后再转换给 GEOS 处理，线性化后的结果可能与原始几何的有效性判定不同 #}
{# @note 每个要素只报告一个错误点位置，即使存在多个无效原因 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Geometry is invalid" — 多边形几何不符合 OGC 规范，可能存在自相交、边相交等无效情况 #}
{# @common_error "Geometry is not simple" — 线串几何存在自相交点（需要 GEOS 3.14+ 才能报告自相交位置） #}
{# @param input file_path required 输入矢量数据源路径 #}
{# @param output file_path required 输出矢量数据源路径（存储检查结果） #}
{# @param layer string optional 要检查的输入图层名称（可重复指定多个） #}
{# @param of format optional 输出格式名称 options=GDALG,GeoJSON,GPKG,ESRI Shapefile #}
{# @param geometry_field string optional 要检查的几何字段名称（默认使用第一个几何字段） #}
{# @param include_field string optional 从输入图层包含到输出的字段（可重复，特殊值 ALL 和 NONE） #}
{# @param include_valid boolean optional 在输出中包含有效要素，空几何表示 #}
{# @param skip_errors boolean optional 写入要素时跳过错误继续处理 #}
{# @param output_layer string optional 输出图层名称 #}
{# @param append boolean optional 追加到现有图层 #}
{# @param overwrite boolean optional 覆盖已存在的输出数据源 #}
{# @param no_create_empty_layers boolean optional 避免创建不会有任何要素写入的图层 #}
{# @param overwrite_layer boolean optional (auto-completed) #}
{# @param update boolean optional (auto-completed) #}

