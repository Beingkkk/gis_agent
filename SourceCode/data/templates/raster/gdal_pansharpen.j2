{# @id gdal_pansharpen #}
{# @name 全色锐化融合 #}
{# @description 将高分辨率全色影像与多光谱影像融合生成高分辨率彩色影像 #}
{# @keyword 遥感 #}
{# @keyword 影像融合 #}
{# @keyword pansharpening #}
{# @keyword 全色 #}
{# @keyword 多光谱 #}
{# @keyword 高分辨率 #}
{# @keyword GeoTIFF #}
{# @concept "全色锐化（Pansharpening）是一种遥感影像融合技术，通过将高空间分辨率的全色影像与高光谱分辨率的多光谱影像融合，生成同时具有高空间分辨率和高光谱信息的彩色影像" #}
{# @concept "gdal_pansharpen 支持经典融合算法，可输出 GeoTIFF 等标准格式或 VRT 虚拟格式" #}
{# @note 全色影像与多光谱影像应具有重叠的地理范围，否则可能产生意外结果 #}
{# @note 输出格式默认根据文件扩展名自动判断，建议显式指定以确保兼容性 #}
{# @common_error "Pan and spectral dataset have different dimensions" — 全色影像与多光谱影像的地理范围或分辨率差异过大，无法正确进行像素级融合 #}
{# @common_error "Unsupported raster file format" — 指定的输出格式不受支持或驱动未安装，需使用 GDAL 支持的格式如 GTiff #}
{# @param pan_dataset file_path required 输入全色影像文件路径（高分辨率单波段） #}
{# @param spectral_dataset file_path required 输入多光谱影像文件路径（可包含多个波段） #}
{# @param out_dataset file_path required 输出锐化融合后的影像文件路径 #}
{# @param of format optional 输出格式名称 default=GTiff options=GTiff,VRT,ENVI,HFA #}
{# @param spectral_band string optional 从多光谱数据中指定要使用的波段序号（从1开始），如 3 #}
{# @param bands string optional 输出波段选择，指定从输入光谱波段中选取哪些波段进行输出（多个用空格分隔） #}
{# @param weights float optional 计算伪全色波段的权重值，个数需与输入光谱数据集数量匹配 #}
{# @param resampling enum optional 重采样算法 default=cubic options=nearest,bilinear,cubic,cubicspline,lanczos,average #}
{# @param threads string optional 并行处理的线程数，可设为 ALL_CPUS 或具体数字 #}
{# @param bitdepth integer optional 指定输出数据的位深度（如 8、12、16） #}
{# @param nodata string optional 指定无效数据值（nodata），用于重采样和融合计算 #}
{# @param spat_adjust enum optional 输入波段范围不一致时的处理方式 default=union options=union,intersection,none,nonewithoutwarning #}
{# @param co text optional 输出格式的创建选项，格式为 KEY=VALUE，可多次使用 #}
{# @param quiet boolean optional 静默模式，抑制进度信息和非错误输出 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_pansharpen

gdal_pansharpen {{ pan_dataset | quote }}{% if spectral_band %} {{ spectral_dataset | quote }},band={{ spectral_band | quote }}{% else %} {{ spectral_dataset | quote }}{% endif %} {{ out_dataset | quote }}{% if of %} -of {{ of | quote }}{% endif %}{% if bands %} -b {{ bands | quote }}{% endif %}{% if weights %} -w {{ weights | quote }}{% endif %}{% if resampling %} -r {{ resampling }}{% endif %}{% if threads %} -threads {{ threads | quote }}{% endif %}{% if bitdepth %} -bitdepth {{ bitdepth }}{% endif %}{% if nodata %} -nodata {{ nodata | quote }}{% endif %}{% if spat_adjust %} -spat_adjust {{ spat_adjust }}{% endif %}{% if co %} -co {{ co | quote }}{% endif %}{% if quiet %} -q{% endif %}

REM Done
