{# @id gdal_merge_mosaic #}
{# @name 影像拼接镶嵌 #}
{# @description 将多幅重叠影像自动拼接为单一图像，支持设置输出范围和分辨率 #}
{# @keyword tif #}
{# @keyword geotiff #}
{# @keyword merge #}
{# @keyword mosaic #}
{# @keyword stitch #}
{# @keyword raster #}
{# @keyword 影像 #}
{# @keyword 拼接 #}
{# @keyword 镶嵌 #}
{# @keyword gdal_merge #}
{# @concept "gdal_merge 是 GDAL 的影像拼接工具，要求所有输入影像使用相同的坐标系统和相同的波段数，重叠区域默认使用最后一张影像覆盖前一幅" #}
{# @concept "拼接时 nodata 值以波段为单位独立处理，单个波段的 nodata 不会影响其他波段的有效值，也不会覆盖其他波段的有效像素" #}
{# @note 输入影像必须具有相同的空间参考系统（SRS），否则无法正确拼接 #}
{# @note 输出范围默认使用所有输入影像的聚合范围，可通过 -ul_lr 手动指定 #}
{# @seealso gdalbuildvrt_virtual #}
{# @common_error "Images have different projections" — 输入影像使用了不同的坐标系统，gdal_merge 要求所有输入必须投影一致才能正确镶嵌 #}
{# @common_error "Images have different band counts" — 输入影像的波段数不一致，拼接前需确保所有输入影像具有相同的波段数量 #}
{# @param output file_path required 输出拼接后的影像文件路径 #}
{# @param input text required 输入影像文件路径列表（支持多个文件，用空格分隔） #}
{# @param of format optional 输出影像格式 default=GTiff options=GTiff,JPEG,PNG,HFA,ENVI,Erdas #}
{# @param ot enum optional 输出数据类型 options=Byte,Int16,UInt16,Int32,UInt32,Float32,Float64,CInt16,CInt32,CFloat32,CFloat64 #}
{# @param ps_x float optional 输出像素X方向分辨率（与ps_y配合使用） #}
{# @param ps_y float optional 输出像素Y方向分辨率 #}
{# @param ul_lr text optional 输出范围（左上X 左上Y 右下X 右下Y），空格分隔的四个坐标值 #}
{# @param tap boolean optional 对齐输出范围到像素分辨率边界 #}
{# @param separate boolean optional 将每个输入文件放入单独波段而非合并到同一波段 #}
{# @param n float optional 输入文件中的无效值（nodata），该值像素将被忽略 #}
{# @param a_nodata float optional 为输出设置nodata值 #}
{# @param init text optional 初始化输出像素值为指定值（单值或带透明通道的多值） #}
{# @param pct boolean optional 从第一个输入影像获取伪彩色表并应用到输出 #}
{# @param createonly boolean optional 仅创建输出文件，不写入像素数据 #}
{# @param quiet boolean optional 静默模式，不输出进度信息 #}
{# @param verbose boolean optional 详细模式，输出每个处理步骤的详细信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_merge_mosaic

gdal_merge -o {{ output | quote }}{% if of %} -of {{ of | quote }}{% endif %}{% if ot %} -ot {{ ot | quote }}{% endif %}{% if ps_x and ps_y %} -ps {{ ps_x | quote }} {{ ps_y | quote }}{% endif %}{% if ul_lr %} -ul_lr {{ ul_lr | quote }}{% endif %}{% if init %} -init {{ init | quote }}{% endif %}{% if n %} -n {{ n | quote }}{% endif %}{% if a_nodata %} -a_nodata {{ a_nodata | quote }}{% endif %}{% if tap %} -tap{% endif %}{% if separate %} -separate{% endif %}{% if pct %} -pct{% endif %}{% if createonly %} -createonly{% endif %}{% if quiet %} -q{% endif %}{% if verbose %} -v{% endif %} -- {{ input | safe_path | quote }}

REM Done
