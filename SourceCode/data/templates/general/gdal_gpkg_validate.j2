{# @id gdal_gpkg_validate #}
{# @name GeoPackage 规范验证 #}
{# @description 验证 GeoPackage 数据集是否符合 OGC GeoPackage 规范标准 #}
{# @keyword gpkg #}
{# @keyword geopackage #}
{# @keyword validate #}
{# @keyword validation #}
{# @keyword 规范验证 #}
{# @keyword conformance #}
{# @keyword sqlite #}
{# @concept "GeoPackage 是基于 SQLite 数据库的开放地理空间数据容器标准，支持矢量和栅格数据，由 OGC（开放地理空间联盟）制定" #}
{# @concept "验证工具检查数据集的元数据完整性、扩展名支持、表结构定义、空间参考系统和数据内容是否符合 GeoPackage 规范要求" #}
{# @note 此工具需要 GDAL Python 绑定支持，运行前请确保已安装 gdal Python 包 #}
{# @note 快速验证仅检查必要要求，完整验证（--full-check）还会检查所有可选规范条目 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "GDAL Python bindings are not available" — 未安装 GDAL Python 绑定，请先通过 pip install gdal 安装 #}
{# @common_error "File is not a valid GeoPackage" — 文件不符合 GeoPackage 规范，可能是文件损坏或使用了非标准格式 #}
{# @param dataset file_path required 待验证的 GeoPackage 文件路径（.gpkg） #}
{# @param full_check boolean optional 是否执行完整检查，包括所有可选规范要求 #}
{# @param verbose boolean optional 详细输出模式，显示每个检查项的具体结果 #}
{# @param quiet boolean optional 静默模式，不显示进度条和警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_gpkg_validate

gdal driver gpkg validate{% if full_check %} --full-check{% endif %}{% if verbose %} -v{% endif %}{% if quiet %} -q{% endif %} {{ dataset | safe_path | quote }}

