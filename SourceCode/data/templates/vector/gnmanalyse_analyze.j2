{# @id gnmanalyse_analyze #}
{# @name 地理网络分析 #}
{# @description 使用 Dijkstra 和 Yen 算法分析地理网络，计算最短路径、K最短路径或资源分布 #}
{# @keyword network #}
{# @keyword 最短路径 #}
{# @keyword dijkstra #}
{# @keyword 路径规划 #}
{# @keyword route #}
{# @keyword kpaths #}
{# @keyword 资源分布 #}
{# @concept "gnmanalyse 是 GDAL 的地理网络分析工具，支持 Dijkstra 单源最短路径算法和 Yen 的 K 最短路径算法" #}
{# @concept "路径计算会考虑要素的阻塞状态，只有未被阻塞的要素才能参与路径计算" #}
{# @note dijkstra 模式计算两个节点间的最优路径，kpaths 模式计算 K 条不同的最短路径 #}
{# @note resource 模式使用广度优先搜索从标记为 EMITTERS 的要素开始进行资源分布计算 #}
{# @common_error "no path found between start and end" — 指定的起点和终点之间不存在有效路径，可能被阻塞要素阻断 #}
{# @common_error "Invalid gfid" — 指定的 GFID 不存在于网络数据中 #}
{# @param gnm_name file_path required 要分析的地理网络数据源路径（GNM 格式） #}
{# @param command_type enum required 分析命令类型 options=dijkstra,kpaths,resource #}
{# @param start_gfid string optional 起始要素的 GDAL 要素 ID（用于路径计算） #}
{# @param end_gfid string optional 终点要素的 GDAL 要素 ID（用于路径计算） #}
{# @param k integer optional K 值，指定要计算的最短路径数量（仅 kpaths 模式使用） #}
{# @param ds file_path optional 输出结果数据集路径（保存为矢量图层） #}
{# @param ds_format format optional 输出数据集格式 default=GeoJSON options=GeoJSON,GPKG,ESRI Shapefile,KML,GML #}
{# @param layer_name string optional 输出图层名称 #}

@echo off
REM Generated by GIS Agent
REM Template: gnmanalyse_analyze

gnmanalyse{% if command_type == 'dijkstra' %} dijkstra {{ start_gfid | quote }} {{ end_gfid | quote }}{% elif command_type == 'kpaths' %} kpaths {{ start_gfid | quote }} {{ end_gfid | quote }} {{ k | quote }}{% elif command_type == 'resource' %} resource{% endif %}{% if ds %} -ds {{ ds | safe_path | quote }}{% endif %}{% if ds_format %} -f {{ ds_format | quote }}{% endif %}{% if layer_name %} -l {{ layer_name | quote }}{% endif %}{% if gnm_name %} {{ gnm_name | safe_path | quote }}{% endif %}

REM Done
