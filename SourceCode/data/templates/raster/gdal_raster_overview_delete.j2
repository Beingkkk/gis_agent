{# @param input file_path required 输入栅格数据集路径，将原地修改（除非使用 --external） #}
{# @param external boolean optional 删除外部创建的概视图（不嵌入在主文件中的概视图） #}
{# @param quiet boolean optional 安静模式，不显示进度条和警告信息 #}
{# @param config text optional GDAL 配置选项，格式为 KEY=VALUE，可重复指定 #}
{# @param open_options text optional 数据打开选项，格式为 KEY=VALUE，可重复指定 #}

