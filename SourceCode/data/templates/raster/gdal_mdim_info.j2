{# @id gdal_mdim_info #}
{# @name 多维数据集信息查询 #}
{# @description 查询多维栅格数据集的结构、数组、属性和统计信息，以 JSON 格式输出 #}
{# @keyword mdim #}
{# @keyword multi-dimensional #}
{# @keyword netcdf #}
{# @keyword hdf5 #}
{# @keyword zarr #}
{# @keyword array #}
{# @keyword 数组 #}
{# @keyword 维度 #}
{# @keyword 元数据 #}
{# @keyword 查询 #}
{# @concept "多维数据集（Multidimensional Dataset）是指包含多个维度的栅格数据，常见于科学数据如气象、海洋、气候模型输出等，支持 NetCDF、HDF5、Zarr 等格式" #}
{# @concept "数组（Array）是多维数据集中的核心结构，每个数组有维度、属性、数据类型、坐标变量等元数据信息" #}
{# @note --summary 和 --detailed 互斥，不能同时使用 #}
{# @note 输出为 JSON 格式，可结合 jq 等工具进行后续数据提取和分析 #}
{# @seealso gdal_mdim_translate #}
{# @common_error "Failed to open raster dataset" — 输入路径不存在，或指定的格式不受 GDAL 多维数据支持 #}
{# @common_error "Array not found" — 指定的数组名称不存在于数据集中，可用无参数命令查看所有可用数组 #}
{# @param input file_path required 输入的多维栅格数据集路径（支持 NetCDF、HDF5、Zarr 等格式） #}
{# @param summary boolean optional 简洁模式，仅显示组和数组层级结构，不包含详细属性信息 #}
{# @param detailed boolean optional 详细模式，输出最完整的信息，包括属性数据类型、数组值等 #}
{# @param stats boolean optional 读取并显示图像统计信息 #}
{# @param array string optional 指定数组名称，仅输出该数组的详细信息 #}
{# @param limit integer optional 限制每个维度显示的值的数量 #}
{# @param config string optional 设置 GDAL 配置选项（KEY=VALUE 格式） #}
{# @param open_option string optional 数据集打开选项（KEY=VALUE 格式） #}
{# @param input_format format optional 强制指定输入格式 options=netCDF,HDF5,Zarr,GRIB,JPEG2000,GDAL #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_mdim_info

gdal mdim info{% if summary %} --summary{% endif %}{% if detailed %} --detailed{% endif %}{% if stats %} --stats{% endif %}{% if array %} --array {{ array | quote }}{% endif %}{% if limit %} --limit {{ limit }}{% endif %}{% if config %} --config {{ config | quote }}{% endif %}{% if open_option %} --open-option {{ open_option | quote }}{% endif %}{% if input_format %} --input-format {{ input_format | quote }}{% endif %} {{ input | safe_path | quote }}

REM Done
