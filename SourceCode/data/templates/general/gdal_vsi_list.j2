{# @id gdal_vsi_list #}
{# @name 虚拟文件系统列表 #}
{# @description 列出 GDAL 虚拟文件系统中的文件，支持递归遍历和多种输出格式 #}
{# @keyword vsi #}
{# @keyword vsimem #}
{# @keyword vsizip #}
{# @keyword vsicurl #}
{# @keyword 文件列表 #}
{# @keyword ls #}
{# @keyword 虚拟文件系统 #}
{# @keyword 列出文件 #}
{# @concept "GDAL 虚拟文件系统（VSI）是 GDAL 访问各种特殊数据源的统一接口，包括内存文件系统(/vsimem)、压缩文件(/vsizip, /vsitar)、远程网络数据(/vsicurl)等" #}
{# @concept "gdal vsi list 类似于 UNIX 的 ls 命令，但能处理 GDAL 支持的任何虚拟文件系统路径" #}
{# @note 支持多种虚拟文件系统路径：/vsimem(内存)、/vsizip(压缩包)、/vsitar(归档)、/vsicurl(远程)等 #}
{# @note 不指定 filename 时，默认列出当前虚拟文件系统的根目录 #}
{# @common_error "File not found" — 指定的虚拟文件系统路径不存在或路径格式错误 #}
{# @common_error "Unable to open" — 无法访问远程文件或压缩包内的文件，可能是网络连接问题或文件权限不足 #}
{# @param filename file_path optional 要列出的文件或目录路径（支持 GDAL 虚拟文件系统路径，如 /vsimem, /vsizip, /vsicurl） #}
{# @param format enum optional 输出格式 default=json options=json,text #}
{# @param long boolean optional 使用长格式列出文件，显示详细信息（如文件大小、修改时间） #}
{# @param recursive boolean optional 递归列出子目录中的文件 #}
{# @param depth integer optional 递归模式下的最大深度层数 #}
{# @param absolute boolean optional 显示文件的绝对路径 #}
{# @param tree boolean optional 以层级树状结构展示 JSON 输出 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vsi_list

gdal vsi list{% if filename %} {{ filename | quote }}{% endif %}{% if format %} --format {{ format }}{% endif %}{% if long %} --long-listing{% endif %}{% if recursive %} --recursive{% endif %}{% if depth %} --depth {{ depth }}{% endif %}{% if absolute %} --absolute-path{% endif %}{% if tree %} --tree{% endif %}

REM Done
