{# @id odbc_read #}
{# @name ODBC数据源读取 #}
{# @description 通过ODBC连接读取数据库表（支持Microsoft Access等），当前为只读驱动 #}
{# @category vector #}
{# @keyword odbc #}
{# @keyword mdb #}
{# @keyword accdb #}
{# @keyword access #}
{# @keyword dsn #}
{# @keyword 数据库 #}
{# @keyword database #}
{# @keyword 只读 #}
{# @keyword readonly #}
{# @concept "ODBC是开放数据库互连标准，GDAL的ODBC驱动允许通过配置好的DSN访问各种数据库的空间和非空间表" #}
{# @concept "当前ODBC驱动为只读模式，不能通过OGR创建新的数据源、图层或要素，但可读取并转换为其他格式" #}
{# @note DSN（数据源名称）需通过操作系统ODBC管理工具预先配置，Linux下可通过unixODBC配置 #}
{# @note 可将ODBC作为ogr2ogr的输入源，把数据库表转换为Shapefile、GeoJSON等格式 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Data source name not found and no default driver specified" — DSN未在系统中正确配置，或DSN名称拼写错误 #}
{# @common_error "[ODBC driver] connection failed" — 用户名/密码错误，或底层数据库服务不可用 #}
{# @param connection string required ODBC连接字符串，格式如 user/password@dsn,schema.tablename(geometrycolname) #}
{# @param layer string optional 要查看的图层（表）名称 #}
{# @param list_all_tables boolean optional 是否列出所有表（包括系统和内部表），仅适用于Microsoft Access数据库 #}

@echo off
REM Generated by GIS Agent
REM Template: odbc_read

ogrinfo ODBC:{{ connection | quote }}{% if layer %} {{ layer | quote }}{% endif %}{% if list_all_tables %} -oo LIST_ALL_TABLES=YES{% endif %}

REM Done
