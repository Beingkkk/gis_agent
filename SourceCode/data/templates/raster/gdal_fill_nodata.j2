{# @id gdal_fill_nodata #}
{# @name 栅格空洞填充 #}
{# @description 使用 GDAL 对栅格数据中的 NoData 区域进行插值填充 #}
{# @keyword nodata #}
{# @keyword fill #}
{# @keyword interpolate #}
{# @keyword gdal #}
{# @keyword raster #}
{# @keyword 空洞填充 #}
{# @keyword 插值 #}
{# @keyword 栅格 #}
{# @concept "fill-nodata 通过逆距离加权（invdist）或最近邻（nearest）方法，从 NoData 区域边缘的有效像素向内插值扩散来填补空洞" #}
{# @concept "该工具会扫描整张影像，识别 NoData 值像元，并根据周围像元值进行插值填充" #}
{# @note 输入栅格应正确设置 NoData 值，否则可能无法正确识别需要填充的区域 #}
{# @note 使用掩膜文件可以精确控制哪些区域参与插值计算 #}
{# @seealso gdal_translate #}
{# @seealso gdal_warp #}
{# @common_error "Input has no nodata value" — 输入栅格未定义 NoData 值，需要先使用 gdal_edit 设置 NoData 值后再进行填充操作 #}
{# @common_error "All pixels are nodata" — 输入栅格完全被 NoData 覆盖，无法进行插值填充，应检查输入数据是否正确 #}
{# @param input file_path required 输入栅格文件路径，定义需要填充 NoData 区域的原始数据 #}
{# @param output file_path required 输出栅格文件路径，保存填充空洞后的结果数据 #}
{# @param of format optional 输出栅格格式 options=GTiff,COG,GPKG,ENVI,HFA #}
{# @param band integer optional 要填充的波段号（从1开始的索引） default=1 #}
{# @param max_distance integer optional 插值搜索的最大距离（像素），超过此距离则不再尝试填充 default=100 #}
{# @param smoothing_iterations integer optional 3x3 平均滤波平滑迭代次数，用于减少插值产生的噪声 #}
{# @param mask file_path optional 掩膜文件路径，用于定义有效/无效区域（零值=无效，非零=有效） #}
{# @param strategy enum optional 插值策略 default=invdist options=invdist,nearest #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_fill_nodata

gdal raster fill-nodata{% if of %} -f {{ of | quote }}{% endif %}{% if band %} -b {{ band }}{% endif %}{% if max_distance %} -d {{ max_distance }}{% endif %}{% if smoothing_iterations %} -s {{ smoothing_iterations }}{% endif %}{% if mask %} --mask {{ mask | safe_path | quote }}{% endif %}{% if strategy %} --strategy {{ strategy | quote }}{% endif %} -i {{ input | safe_path | quote }} -o {{ output | safe_path | quote }}

REM Done
