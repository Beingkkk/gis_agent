{# @id gdal_vector_simplify #}
{# @name 矢量数据几何简化 #}
{# @description 使用 Douglas-Peucker 算法简化矢量数据的几何形状，同时保持拓扑有效性 #}
{# @keyword simplify #}
{# @keyword douglas-peucker #}
{# @keyword geometry #}
{# @keyword topology #}
{# @keyword 矢量简化 #}
{# @keyword 几何简化 #}
{# @keyword shp #}
{# @keyword geojson #}
{# @concept "Simplify 采用 Douglas-Peucker 类似的最大距离差算法，通过 OGRGeometry::SimplifyPreserveTopology() 实现，保持每个要素的拓扑有效性" #}
{# @concept "简化后几何保持与输入相同的维度和要素数量，但复杂度降低，文件体积减小" #}
{# @note 容差值的单位与数据坐标单位一致：地理坐标系用度，投影坐标系用米 #}
{# @note 该工具按要素独立保持拓扑，但不会保持整个图层中相邻几何之间的共享边界，可能产生间隙或重叠 #}
{# @seealso ogr2ogr_convert #}
{# @seealso gdal_vector_simplify_coverage #}
{# @common_error "No GDAL built against GEOS" — GDAL 未在编译时链接 GEOS 库，无法执行简化操作，需重新编译 GDAL 添加 GEOS 支持 #}
{# @common_error "Invalid geometry type" — 输入数据包含不支持的几何类型，Simplify 仅支持基本几何类型 #}
{# @param input file_path required 输入矢量数据文件路径或数据源 #}
{# @param output file_path required 输出矢量数据文件路径或数据源 #}
{# @param tolerance float required 简化容差距离，单位与数据坐标单位相同（如度或米），值越大简化程度越高 #}
{# @param of format optional 输出格式 default=GeoJSON options=GeoJSON,ESRI Shapefile,GPKG,KML,MapInfo File,GML,CSV #}
{# @param layer string optional 输入图层名称（可重复指定多个图层） #}
{# @param output_layer string optional 输出图层名称 #}
{# @param lco string optional 图层创建选项（KEY=VALUE 格式） #}
{# @param overwrite boolean optional 允许覆盖已存在的输出数据集 #}
{# @param append boolean optional 追加到现有图层（与 upsert 互斥） #}
{# @param skip_errors boolean optional 写入要素时跳过错误 #}
{# @param active_layer string optional 设置活动图层名称（不指定则处理所有图层） #}
{# @param active_geometry string optional 指定要处理的几何字段名称 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vector_simplify

gdal vector simplify{% if layer %} -l {{ layer | quote }}{% endif %}{% if of %} -f {{ of | quote }}{% endif %}{% if lco %} --lco {{ lco | quote }}{% endif %}{% if overwrite %} --overwrite{% endif %}{% if append %} --append{% endif %}{% if output_layer %} --output-layer {{ output_layer | quote }}{% endif %}{% if skip_errors %} --skip-errors{% endif %}{% if active_layer %} --active-layer {{ active_layer | quote }}{% endif %}{% if active_geometry %} --active-geometry {{ active_geometry | quote }}{% endif %} {{ input | safe_path | quote }} {{ output | safe_path | quote }} {{ tolerance }}

REM Done
