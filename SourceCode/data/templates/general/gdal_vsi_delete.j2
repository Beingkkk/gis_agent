{# @id gdal_vsi_delete #}
{# @name 虚拟文件系统文件删除 #}
{# @description 删除 GDAL 虚拟文件系统中的文件或目录 #}
{# @keyword vsi #}
{# @keyword rm #}
{# @keyword delete #}
{# @keyword 文件删除 #}
{# @keyword 虚拟文件系统 #}
{# @keyword vsizip #}
{# @keyword vsicurl #}
{# @concept "GDAL 虚拟文件系统 (VSI) 支持访问各种虚拟文件系统的文件，包括内存文件系统 (/vsimem)、ZIP 文件系统 (/vsizip)、Tar 文件系统 (/vsitar)、网络文件系统 (/vsicurl) 等" #}
{# @note 此命令不可撤销，删除操作无法恢复，请谨慎使用 #}
{# @note 可作用于本地真实文件系统而非仅限于虚拟文件系统 #}
{# @common_error "Delete of file failed" — 文件不存在、路径错误或没有删除权限 #}
{# @param filename file_path required 要删除的文件或目录路径（支持 GDAL 虚拟文件系统路径） #}
{# @param recursive boolean optional 递归删除目录及其所有内容 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vsi_delete

gdal vsi delete{% if recursive %} -r{% endif %} {{ filename | safe_path | quote }}

REM Done
