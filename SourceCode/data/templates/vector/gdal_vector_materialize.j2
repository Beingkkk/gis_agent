{# @param output file_path optional 物化输出数据集的文件路径 #}
{# @param of format optional 输出格式名称 default=GPKG options=GPKG,GeoJSON,ESRI Shapefile,SQLite,GML,DXF #}
{# @param co text optional 数据集创建选项（KEY=VALUE格式，可重复使用） #}
{# @param lco text optional 图层创建选项（KEY=VALUE格式，可重复使用） #}
{# @param overwrite boolean optional 是否允许覆盖已存在的输出数据集 #}

@echo off
REM Generated by GIS Agent
