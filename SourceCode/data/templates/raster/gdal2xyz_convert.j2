{# @param srcnodata string optional 源数据 NoData 值（默认使用数据集自带值） #}
{# @param dstnodata string optional 输出时替换的 NoData 值 #}
{# @param skip integer optional 每隔多少行/列跳过一次采样（降采样） #}
{# @param srcwin string optional 裁剪窗口：xoff yoff xsize ysize（空格分隔） #}

@echo off
REM Generated by GIS Agent
