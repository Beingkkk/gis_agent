{# @id gdal_vsi_move #}
{# @name VSI文件移动 #}
{# @description 在GDAL虚拟文件系统(/vsimem、/vsizip、/vsicurl等)之间移动或重命名文件和目录 #}
{# @keyword vsi #}
{# @keyword vsimem #}
{# @keyword vsizip #}
{# @keyword vsicurl #}
{# @keyword 移动 #}
{# @keyword 重命名 #}
{# @keyword 文件操作 #}
{# @concept "GDAL虚拟文件系统(VSI)是一套抽象的文件访问接口，支持内存文件(/vsimem)、压缩文件(/vsizip、/vsitar)、网络存储(/vsicurl)等多种数据源" #}
{# @concept "该命令可以跨不同虚拟文件系统移动文件，但涉及复制和删除操作，不是原子性的" #}
{# @note 当目标路径为已存在的目录时，源文件将被移动到该目录下 #}
{# @note 对于云对象存储，重命名目录可能需要递归重命名所有包含的文件，速度较慢且费用较高 #}
{# @seealso gdal_vsi_ls #}
{# @common_error "文件或路径不存在" — 源路径不存在或VSI路径格式不正确 #}
{# @common_error "目标路径已存在同名文件" — 移动操作可能会覆盖已有文件，系统不会自动提示 #}
{# @param source string required 源文件或目录路径（支持GDAL虚拟文件系统路径，如/vsimem、/vsizip、/vsicurl等） #}
{# @param destination string required 目标文件或目录路径 #}
{# @param quiet boolean optional 静默模式，不显示进度条和警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vsi_move

gdal vsi move{% if quiet %} -q{% endif %} {{ source | quote }} {{ destination | quote }}

REM Done
