{# @common_error "Too many points in polygon" — 输出多边形顶点数超过 -max_points 限制，可设为 unlimited 或增大该值 #}
{# @param input file_path required 输入栅格文件路径（源数据集） #}
{# @param output file_path required 输出矢量文件路径（目标数据集） #}
{# @param of format optional 输出矢量格式名称 default=ESRI Shapefile options=ESRI Shapefile,GeoJSON,GPKG,KML #}
{# @param bands string optional 要处理的波段号（可指定多个，如 "1" 或 "1 2 3"） #}
