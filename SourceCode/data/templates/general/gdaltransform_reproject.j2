{# @param s_coord_epoch float optional 源坐标系历元，用于动态坐标系转换（版本 3.8+） #}
{# @param t_coord_epoch float optional 目标坐标系历元，用于动态坐标系转换（版本 3.8+） #}
{# @param ct text optional 自定义坐标转换操作（PROJ 管线字符串、WKT2 或 EPSG URN），覆盖默认转换 #}
{# @param i boolean optional 执行逆变换：从目标坐标系转换到源坐标系 #}
{# @param output_xy boolean optional 限制输出为 "x y" 格式，不包含高程值 z #}

