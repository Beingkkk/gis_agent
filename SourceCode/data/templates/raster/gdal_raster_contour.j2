{# @id gdal_raster_contour #}
{# @name 栅格等值线生成 #}
{# @description 从栅格DEM数据提取矢量等值线/高程线 #}
{# @keyword dem #}
{# @keyword contour #}
{# @keyword elevation #}
{# @keyword 等值线 #}
{# @keyword 高程 #}
{# @keyword 矢量 #}
{# @keyword 栅格 #}
{# @concept "gdal raster contour 是 GDAL 的栅格等值线提取工具，从 DEM 栅格数据中生成矢量等值线" #}
{# @concept "支持指定等值线间隔、精确高程值列表、3D输出等多种模式" #}
{# @note 等值线间隔(--interval)和指定高程值(--levels)为互斥选项 #}
{# @note 输出格式默认根据文件扩展名自动判断，常用格式包括 ESRI Shapefile、GPKG、GeoJSON #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Too many points in line" — 等值线几何过于复杂，需简化输入DEM或增加间隔值 #}
{# @common_error "Input is non-floating point" — 输入栅格数据类型不是浮点型，需使用高程数据（如Int16、Float32） #}
{# @param input file_path required 输入栅格DEM文件路径 #}
{# @param output file_path required 输出矢量等值线文件路径 #}
{# @param of format optional 输出格式名称（默认从扩展名判断） options=ESRI Shapefile,GPKG,GeoJSON,KML,GML #}
{# @param interval float optional 等值线间隔高度，与--levels互斥 #}
{# @param levels string optional 指定等值线高程值列表（逗号分隔），与--interval互斥 #}
{# @param offset float optional 等值线高程值偏移量 #}
{# @param elevation_name string optional 输出矢量要素的高程字段名称（默认ELEV） #}
{# @param band integer optional 输入栅格波段号（1-based，默认为1） default=1 #}
{# @param input_nodata float optional 输入栅格的nodata值 #}
{# @param 3d boolean optional 生成3D矢量线（包含高程Z值） #}
{# @param polygonize boolean optional 生成等值面（多边形）而非等值线（折线） #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_raster_contour

gdal raster contour{% if of %} -f {{ of | quote }}{% endif %}{% if interval %} -i {{ interval }}{% endif %}{% if levels %} --levels {{ levels | quote }}{% endif %}{% if offset %} --off {{ offset }}{% endif %}{% if elevation_name %} --elevation-name {{ elevation_name | quote }}{% endif %}{% if band and band != 1 %} -b {{ band }}{% endif %}{% if input_nodata %} --input-nodata {{ input_nodata }}{% endif %}{% if 3d %} --3d{% endif %}{% if polygonize %} -p{% endif %} {{ input | safe_path | quote }} {{ output | safe_path | quote }}

