gdal2xyz{% if allbands %} -allbands{% endif %}{% if band %} -b {{ band | quote }}{% endif %}{% if csv %} -csv{% endif %}{% if skipnodata %} -skipnodata{% endif %}{% if srcnodata %} -srcnodata {{ srcnodata | quote }}{% endif %}{% if dstnodata %} -dstnodata {{ dstnodata | quote }}{% endif %}{% if skip %} -skip {{ skip }}{% endif %}{% if srcwin %} -srcwin {{ srcwin | quote }}{% endif %} {{ input | safe_path | quote }} {{ output | safe_path | quote }}

