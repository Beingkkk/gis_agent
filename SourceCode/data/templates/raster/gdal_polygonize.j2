{# @param output file_path required 输出矢量文件路径（目标数据集） #}
{# @param of format optional 输出矢量格式 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML,CSV #}
{# @param band integer optional 输入栅格波段编号（从1开始） default=1 #}
{# @param attribute_name string optional 存储像素值的属性字段名称 default=DN #}
{# @param connect_diagonal_pixels boolean optional 将仅对角相连的像素视为连通区域（生成单一多边形） #}
