{# @id gdal_vector_filter #}
{# @name 矢量数据过滤器 #}
{# @description 基于空间范围或SQL属性条件过滤矢量数据，可用于数据筛选和裁剪 #}
{# @keyword shp #}
{# @keyword shapefile #}
{# @keyword geojson #}
{# @keyword gpkg #}
{# @keyword 矢量过滤 #}
{# @keyword 空间裁剪 #}
{# @keyword 属性筛选 #}
{# @keyword bbox #}
{# @keyword where #}
{# @concept "gdal vector filter 用于根据空间范围（bbox）或属性条件（where）对矢量数据进行筛选过滤" #}
{# @concept "该工具可作为 gdal vector pipeline 流水线的一个处理步骤使用" #}
{# @note bbox 参数使用逗号分隔的四值格式，依次为 xmin,ymin,xmax,ymax，代表地理空间范围 #}
{# @note where 参数使用 SQL WHERE 子句的简化形式，不支持复杂嵌套查询 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "bbox format must be xmin,ymin,xmax,ymax" — bbox 参数格式错误，需要提供四个数值且用逗号分隔，例如 116,39,117,40 #}
{# @common_error "Unable to open datasource" — 输入文件路径不存在或格式不支持，请检查文件是否可读 #}
{# @param input file_path required 输入矢量数据源路径（支持文件或目录） #}
{# @param output file_path required 输出矢量数据目标路径 #}
{# @param bbox string optional 空间范围过滤条件，格式为 xmin,ymin,xmax,ymax（如 116.0,39.0,117.0,40.0） #}
{# @param where string optional 属性查询条件（SQL WHERE 子句的简化形式，如 name='北京'） #}
{# @param layer string optional 输入图层名称，指定要处理的特定图层 #}
{# @param active_layer string optional 设置活动图层名称，默认为所有图层 #}
{# @param of format optional 输出格式名称 options=GeoJSON,ESRI Shapefile,GPKG,KML,GML,CSV,Memory #}
{# @param append boolean optional 是否追加到现有图层而非创建新图层 #}
{# @param skip_errors boolean optional 写入要素时是否跳过错误继续处理 #}
{# @param overwrite boolean optional 是否允许覆盖已存在的输出数据源 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vector_filter

gdal vector filter{% if layer %} --layer {{ layer | quote }}{% endif %}{% if of %} --of {{ of | quote }}{% endif %}{% if active_layer %} --active-layer {{ active_layer | quote }}{% endif %}{% if bbox %} --bbox {{ bbox | quote }}{% endif %}{% if where %} --where {{ where | quote }}{% endif %}{% if append %} --append{% endif %}{% if skip_errors %} --skip-errors{% endif %}{% if overwrite %} --overwrite{% endif %}{{ input | safe_path | quote }} {{ output | safe_path | quote }}

