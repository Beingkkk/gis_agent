{# @id gdal_vector_info #}
{# @name 矢量数据集信息查询 #}
{# @description 使用 gdal vector info 查询 GDAL 支持的矢量数据集的元信息、图层结构、要素详情等 #}
{# @keyword vector #}
{# @keyword info #}
{# @keyword metadata #}
{# @keyword ogr #}
{# @keyword shp #}
{# @keyword geojson #}
{# @keyword gpkg #}
{# @keyword 图层信息 #}
{# @keyword 要素查询 #}
{# @concept "gdal vector info 是 GDAL 3.x 引入的矢量数据查询工具，可获取数据集的元信息、图层列表、要素数量、字段结构、几何类型和坐标系等详细信息" #}
{# @concept "支持 SQL 查询和属性筛选，可以方便地查看矢量数据的结构和内容" #}
{# @note 使用 --features 列出全部要素可能消耗大量内存，大数据集建议使用 --limit 限制数量或使用 --summary 查看概况 #}
{# @note 输出格式默认为 JSON，便于程序解析；也可指定 text 格式便于人工阅读 #}
{# @seealso ogr2ogr_convert #}
{# @seealso gdal_raster_info #}
{# @common_error "Unable to open datasource" — 输入文件路径不存在、文件格式不支持或文件损坏 #}
{# @common_error "Layer not found" — 指定的图层名称不存在，使用 --summary 可以查看所有可用图层 #}
{# @param input file_path required 输入矢量数据集路径（支持 shp、geojson、gpkg 等格式） #}
{# @param of format optional 输出格式 default=json options=json,text #}
{# @param layer string optional 指定要查询的图层名称 #}
{# @param features boolean optional 列出所有要素详情（大数据集可能消耗大量内存） #}
{# @param summary boolean optional 仅列出图层名称和几何类型 #}
{# @param limit integer optional 限制每个图层返回的要素数量（隐含 --features） #}
{# @param sql string optional 执行 SQL 查询语句并返回结果 #}
{# @param where string optional 属性筛选条件（SQL WHERE 子句的简化形式） #}
{# @param fid string optional 按要素 ID 查询单个要素 #}
{# @param dialect string optional SQL 方言（OGRSQL、SQLITE 等） #}
{# @param crs_format enum optional 坐标系输出格式 options=AUTO,WKT2,PROJJSON #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vector_info

gdal vector info{% if of %} -f {{ of | quote }}{% endif %}{% if layer %} -l {{ layer | quote }}{% endif %}{% if features %} --features{% endif %}{% if summary %} --summary{% endif %}{% if limit %} --limit {{ limit | quote }}{% endif %}{% if where %} --where {{ where | quote }}{% endif %}{% if sql %} --sql {{ sql | quote }}{% endif %}{% if fid %} --fid {{ fid | quote }}{% endif %}{% if dialect %} --dialect {{ dialect | quote }}{% endif %}{% if crs_format %} --crs-format {{ crs_format | quote }}{% endif %} {{ input | safe_path | quote }}

