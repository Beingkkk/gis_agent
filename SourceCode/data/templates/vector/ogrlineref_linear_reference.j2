{# @id ogrlineref_linear_reference #}
{# @name 线性参照创建与查询 #}
{# @description 创建线性参照文件，查询线状地物上特定坐标点的线性距离或获取路径区段 #}
{# @keyword 线性参照 #}
{# @keyword 里程 #}
{# @keyword 道路 #}
{# @keyword 参考 #}
{# @keyword 路线 #}
{# @keyword lineref #}
{# @keyword linear referencing #}
{# @keyword km #}
{# @concept "线性参照是一种沿路径距离进行定位的方法，常用于道路里程管理，如某点位于道路5.2公里处" #}
{# @concept "创建线性参照文件时需要线路数据（线状要素）和参照点数据（已知里程的标记点），工具会将线路切分为指定长度的段落并存储" #}
{# @note 工具支持多种工作模式：创建参照文件(-create)、查询坐标点距离(-get_pos)、根据距离查坐标(-get_coord)、提取路径区段(-get_subline) #}
{# @note 不要求几何包含M或Z分量，纯二维即可工作 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Failed to find match" — 查询坐标或距离超出线性参照文件覆盖范围，或参照文件未正确创建 #}
{# @common_error "Unable to open datasource" — 指定的数据源路径不存在或格式不支持 #}
{# @param create boolean optional 创建线性参照文件标志（而非查询已有文件） #}
{# @param l file_path optional 线状源数据路径（如道路数据） #}
{# @param ln string optional 线状源数据中的图层名称 #}
{# @param lf string optional 唯一值字段名，用于区分不同线路（如道路编号） #}
{# @param p file_path optional 参照点数据源路径（如里程点、道路里程碑） #}
{# @param pn string optional 参照点数据源中的图层名称 #}
{# @param pm string optional 沿路径距离的字段名（如里程碑值） #}
{# @param pf string optional 唯一值字段名，用于将参照点映射到线路 #}
{# @param r file_path optional 已有线性参照文件路径（查询模式必需） #}
{# @param rn string optional 线性参照文件中的图层名称 #}
{# @param o file_path optional 输出线性参照文件路径 #}
{# @param on string optional 输出图层名称 #}
{# @param of string optional 存储输入线路唯一值的字段名 #}
{# @param s float optional 分段长度（参照单位，如公里） #}
{# @param get_pos boolean optional 根据输入坐标获取线性参照距离 #}
{# @param x float optional 输入点X坐标（配合-get_pos使用） #}
{# @param y float optional 输入点Y坐标（配合-get_pos使用） #}
{# @param get_coord boolean optional 根据线性距离获取路径上的坐标点 #}
{# @param m float optional 输入的线性距离值（配合-get_coord使用） #}
{# @param get_subline boolean optional 获取路径的一部分区段 #}
{# @param mb float optional 区段起始的线性距离（配合-get_subline使用） #}
{# @param me float optional 区段结束的线性距离（配合-get_subline使用） #}

@echo off
