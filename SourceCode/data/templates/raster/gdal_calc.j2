{# @id gdal_calc #}
{# @name 栅格计算器 #}
{# @description 使用NumPy语法对栅格数据进行数学运算和逻辑运算，支持多波段输出 #}
{# @keyword tif #}
{# @keyword geotiff #}
{# @keyword raster #}
{# @keyword calculator #}
{# @keyword numpy #}
{# @keyword 算术 #}
{# @keyword band #}
{# @keyword 逻辑运算 #}
{# @keyword 波段运算 #}
{# @concept "gdal_calc是一个基于NumPy语法的栅格计算器，支持加(+)、减(-)、乘(*)、除(/)等算术运算以及逻辑运算符(如>)和NumPy函数(如log10())" #}
{# @concept "多个输入栅格用不同字母(如A、B、C)标识，计算表达式中直接使用这些字母引用对应数据，所有输入栅格必须具有相同尺寸(除非使用--extent选项)" #}
{# @note 计算表达式中引用输入栅格使用英文字母A-Z，如 A+B 表示两个栅格相加，A>0 表示创建掩膜 #}
{# @note GDAL 3.2及以上版本支持多次使用--calc参数生成多波段输出文件 #}
{# @seealso ogr2ogr_convert #}
{# @common_error "ValueError: operands could not be broadcast together" — 输入栅格的尺寸不一致，需要使用--extent选项指定处理方式，或确保所有输入栅格具有相同的行列数 #}
{# @common_error "TypeError: unsupported operand type" — 计算表达式语法错误，检查是否使用了正确的NumPy语法，如乘号用*而非× #}
{# @param calc string required NumPy语法计算表达式（如 A+B, A*2, A>0），可使用逻辑运算符和NumPy函数 #}
{# @param outfile file_path required 输出栅格文件路径 #}
{# @param A file_path optional 输入栅格文件A（使用英文字母A-Z命名输入文件） #}
{# @param A_band integer optional 输入文件A使用的波段号（从1开始，默认1） #}
{# @param B file_path optional 输入栅格文件B（用于多文件运算） #}
{# @param C file_path optional 输入栅格文件C #}
{# @param D file_path optional 输入栅格文件D #}
{# @param type enum optional 输出数据类型 default=Float32 options=Byte,Int8,UInt16,Int16,UInt32,Int32,Float64,Float32 #}
{# @param format format optional 输出栅格格式 default=GTiff options=GTiff,HFA,ENVI,COG,GPKG #}
{# @param NoDataValue string optional 输出的NoData值，设为none表示不设置 #}
{# @param hideNoData boolean optional 使输入栅格的NoData值参与计算而不是被忽略 #}
{# @param extent enum optional 处理不同范围输入栅格的方式 default=ignore options=ignore,fail,union,intersect #}
{# @param projwin string optional 自定义输出范围：左 上 右 下（ulx uly lrx lry） #}
{# @param projectionCheck boolean optional 检查所有输入栅格是否具有相同的投影 #}
{# @param creation_option string optional 传递给输出格式驱动程序的创建选项 #}
{# @param allBands string optional 对指定输入的所有波段应用同一表达式 #}
{# @param overwrite boolean optional 如果输出文件已存在则覆盖 #}
{# @param quiet boolean optional 静默模式，不显示进度信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_calc

gdal_calc --calc={{ calc | quote }}{% if outfile %} --outfile={{ outfile | quote }}{% endif %}{% if A %} -A {{ A | quote }}{% endif %}{% if A_band %} --A_band={{ A_band | quote }}{% endif %}{% if B %} -B {{ B | quote }}{% endif %}{% if C %} -C {{ C | quote }}{% endif %}{% if D %} -D {{ D | quote }}{% endif %}{% if type %} --type={{ type }}{% endif %}{% if format %} --format={{ format }}{% endif %}{% if NoDataValue %} --NoDataValue={{ NoDataValue | quote }}{% endif %}{% if hideNoData %} --hideNoData{% endif %}{% if extent %} --extent={{ extent }}{% endif %}{% if projwin %} --projwin {{ projwin | quote }}{% endif %}{% if projectionCheck %} --projectionCheck{% endif %}{% if creation_option %} --creation-option={{ creation_option | quote }}{% endif %}{% if allBands %} --allBands={{ allBands | quote }}{% endif %}{% if overwrite %} --overwrite{% endif %}{% if quiet %} --quiet{% endif %}

REM Done
