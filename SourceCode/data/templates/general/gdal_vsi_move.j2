{# @id gdal_vsi_move #}
{# @name 虚拟文件系统文件移动 #}
{# @description 在 GDAL 虚拟文件系统中移动或重命名文件及目录，支持不同虚拟文件系统间操作 #}
{# @keyword vsi #}
{# @keyword move #}
{# @keyword mv #}
{# @keyword 虚拟文件系统 #}
{# @keyword 重命名 #}
{# @keyword vsimem #}
{# @keyword vsicurl #}
{# @keyword cloud #}
{# @concept "GDAL 虚拟文件系统（VSI）允许通过统一接口访问内存文件（/vsimem）、压缩包（/vsizip、/vsitar）、远程云存储（/vsicurl）等多种数据源" #}
{# @concept "该工具等同于 Unix 的 mv 命令，可在不同虚拟文件系统间移动文件，但云存储目录移动涉及递归重命名所有文件，非原子操作且可能耗时" #}
{# @note 目标路径若为已存在目录，文件将移动到该目录下 #}
{# @note gdal vsi mv 是 gdal vsi move 的别名，两者功能完全相同 #}
{# @common_error "Unable to open source" — 源文件路径不存在、格式不支持或权限不足 #}
{# @common_error "Destination path error" — 目标路径无效（如磁盘空间不足、目录只读等） #}
{# @param source file_path required 源文件或目录路径（支持 GDAL 虚拟文件系统，如 /vsimem、/vsizip、/vsicurl 等） #}
{# @param destination file_path required 目标文件或目录路径 #}
{# @param config text optional GDAL 配置选项，格式为 KEY=VALUE（可重复使用） #}
{# @param quiet boolean optional 静默模式，不显示进度条或警告信息 #}

@echo off
REM Generated by GIS Agent
REM Template: gdal_vsi_move

gdal vsi move{% if quiet %} -q{% endif %}{% if config %} --config {{ config | quote }}{% endif %} {{ source | safe_path | quote }} {{ destination | safe_path | quote }}

REM Done
