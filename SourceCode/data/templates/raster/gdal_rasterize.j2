{# @param input file_path required 输入矢量数据源路径（支持 Shapefile、GeoJSON 等 OGR 格式） #}
{# @param output file_path required 输出栅格文件路径（支持 GeoTIFF 等 GDAL 栅格格式） #}
{# @param burn integer optional 固定像素值，用于将所有矢量要素烧录为同一值 #}
{# @param a string optional 从矢量要素的属性字段中获取像素值 #}
{# @param of format optional 输出栅格格式 default=GTiff options=GTiff,HFA,ENVI,AIG,HDF4,JPEG,PNG #}
{# @param ot enum optional 输出数据类型 default=Float64 options=Byte,Int16,UInt16,Int32,UInt32,Float32,Float64 #}
{# @param tr_x float optional 输出像元 X 方向分辨率（须与 tr_y 配合使用，不能与 ts 同时使用） #}
{# @param tr_y float optional 输出像元 Y 方向分辨率（须与 tr_x 配合使用，不能与 ts 同时使用） #}
{# @param ts_w integer optional 输出栅格宽度（像素数，须与 ts_h 配合使用，不能与 tr 同时使用） #}
{# @param ts_h integer optional 输出栅格高度（像素数，须与 ts_w 配合使用，不能与 tr 同时使用） #}
{# @param at boolean optional 启用 ALL_TOUCHED 模式，确保所有被矢量要素触及的像素都被更新 #}
{# @param add boolean optional 将新值添加到现有像素值而非替换，适合生成热力图等 #}
{# @param te_xmin float optional 输出范围 X 最小值（与 ymin/xmax/ymax 配合设置裁剪区域） #}
{# @param te_ymin float optional 输出范围 Y 最小值 #}
{# @param te_xmax float optional 输出范围 X 最大值 #}
{# @param te_ymax float optional 输出范围 Y 最大值 #}
{# @param init integer optional 初始化值，在栅格化前填充所有像素 #}
{# @param a_nodata float optional 设置输出 NoData 值 #}
{# @param a_srs crs optional 指定输出栅格的空间参考系统定义 #}
{# @param where string optional SQL WHERE 条件表达式，用于筛选要栅格化的要素 #}
{# @param sql string optional SQL 查询语句，用于从数据源提取虚拟图层 #}
{# @param l string optional 指定输入数据源中的图层名称 #}
{# @param i boolean optional 反转栅格化，将要素外部区域烧录为固定值 #}
{# @param te boolean optional (auto-completed) #}
