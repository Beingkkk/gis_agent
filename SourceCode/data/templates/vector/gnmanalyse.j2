{# @id gnmanalyse #}
{# @name 网络路径分析 #}
{# @description 使用 Dijkstra、Yen 等算法对地理网络数据进行最短路径、K最短路径和资源分布分析 #}
{# @keyword gnm #}
{# @keyword network #}
{# @keyword dijkstra #}
{# @keyword 最短路径 #}
{# @keyword kpaths #}
{# @keyword 网络分析 #}
{# @keyword yen #}
{# @concept "gnmanalyse 是 GDAL 的地理网络分析工具，基于 GNM（Geographical Network Model）模型处理网络数据" #}
{# @concept "支持三种算法：Dijkstra 计算单源最短路径、Yen 的 K 最短路径算法、BFS 资源分布计算" #}
{# @note dijkstra 和 kpaths 算法必须提供 start_gfid 和 end_gfid 参数，kpaths 额外需要 k 参数 #}
{# @note resource 算法无需额外参数，但要求网络中存在标记为 'EMITTERS' 的特征 #}
{# @seealso gnmmanage #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Invalid gfid value provided" — 指定的起点或终点特征 ID 在网络中不存在 #}
{# @common_error "Network is empty" — 输入的 GNM 网络文件不包含任何有效要素或连接关系 #}
{# @param gnmi_name file_path required 输入的 GNM 网络数据文件路径 #}
{# @param algorithm enum required 分析算法类型 options=dijkstra,kpaths,resource #}
{# @param start_gfid integer optional 起点要素的 GDAL 特征 ID（用于 dijkstra 和 kpaths 算法） #}
{# @param end_gfid integer optional 终点要素的 GDAL 特征 ID（用于 dijkstra 和 kpaths 算法） #}
{# @param k integer optional K 最短路径的数量（仅用于 kpaths 算法） #}
{# @param ds file_path optional 输出结果数据集路径（可不预先存在） #}
{# @param f format optional 输出数据格式 default=GeoJSON options=GeoJSON,ESRI Shapefile,GPKG,KML #}
{# @param l string optional 输出图层名称（已存在则覆盖） #}

@echo off
REM Generated by GIS Agent
REM Template: gnmanalyse

gnmanalyse {% if algorithm %}{{ algorithm }}{% endif %}{% if start_gfid %} {{ start_gfid }}{% endif %}{% if end_gfid %} {{ end_gfid }}{% endif %}{% if k %} {{ k }}{% endif %}{% if ds %} -ds {{ ds | quote }}{% endif %}{% if f %} -f {{ f | quote }}{% endif %}{% if l %} -l {{ l | quote }}{% endif %} {{ gnmi_name | quote }}

