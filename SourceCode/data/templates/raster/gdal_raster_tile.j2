{# @id gdal_raster_tile #}
{# @name 栅格影像切片生成 #}
{# @description 将栅格数据集按WMTS标准生成Web地图瓦片，支持多种切片方案和缩放级别 #}
{# @keyword 瓦片 #}
{# @keyword tile #}
{# @keyword 切片 #}
{# @keyword wmts #}
{# @keyword xyz #}
{# @keyword tms #}
{# @keyword png #}
{# @keyword webp #}
{# @keyword web地图 #}
{# @concept "gdal raster tile 根据OGC WMTS规范将栅格影像切分成小瓦片，生成可在Web浏览器中快速加载的切片金字塔结构" #}
{# @concept "支持WebMercatorQuad、Google XYZ等多种切片方案，可选择XYZ（从上往下）或TMS（从下往上）的瓦片编号方式" #}
{# @note 默认输出PNG格式，JPEG和WEBP仅支持Byte数据类型，GeoTiff支持所有数据类型 #}
{# @note 使用raster切片方案时，瓦片原点和分辨率会自动适配输入栅格，最大缩放级别下瓦片分辨率与栅格分辨率一致 #}
{# @seealso gdal_retile #}
{# @seealso gdal_translate #}
{# @common_error "Unable to open datasource" — 输入栅格文件路径不存在或格式不支持，检查文件是否损坏 #}
{# @common_error "Dataset extent does not intersect tile matrix at any zoom level" — 输入栅格范围与切片方案无交集，可使用--no-intersection-ok将其降级为警告 #}
{# @param input file_path required 输入栅格数据集路径 #}
{# @param output folder_path required 输出瓦片目录 #}
{# @param of format optional 输出瓦片格式 default=PNG options=PNG,JPEG,WEBP,GTiff #}
{# @param tiling_scheme enum optional 切片方案 default=WebMercatorQuad options=raster,WebMercatorQuad,WorldCRS84Quad,WorldMercatorWGS84Quad,GoogleCRS84Quad,PseudoTMS_GlobalMercator,GlobalGeodeticOriginLat270,LINZAntarticaMapTilegrid,APSTILE,CBMTILE,NZTM2000 #}
{# @param min_zoom integer optional 最小缩放级别 #}
{# @param max_zoom integer optional 最大缩放级别 #}
{# @param resampling enum optional 重采样方法（用于最大缩放级别） default=cubic options=nearest,bilinear,cubic,cubicspline,lanczos,average,rms,mode,min,max,med,q1,q3,sum #}
{# @param convention enum optional 瓦片编号约定：xyz从上往下还是tms从下往上 default=xyz options=xyz,tms #}
{# @param tile_size integer optional 覆盖默认瓦片尺寸 #}
{# @param co text optional 创建选项（KEY=VALUE格式） #}
{# @param add_alpha boolean optional 强制添加Alpha通道 #}
{# @param no_alpha boolean optional 禁用添加Alpha通道 #}
{# @param output_nodata float optional 输出nodata值 #}
{# @param skip_blank boolean optional 不生成空白瓦片 #}
{# @param kml boolean optional 生成KML文件 #}
{# @param resume boolean optional 仅生成缺失文件（断点续传） #}
{# @param j string optional 并发线程数（默认ALL_CPUS） #}
{# @param webviewer enum optional 生成的Web查看器类型 default=all options=none,all,leaflet,openlayers,mapml,stac #}
{# @param url string optional 发布瓦片的URL地址 #}
{# @param title string optional 地图标题 #}
{# @param copyright string optional 地图版权信息 #}
{# @param mapml_template file_path optional MAPML模板文件路径 #}
{# @param metadata text optional 添加元数据项（KEY=VALUE格式） #}
{# @param copy_src_metadata boolean optional 从源数据集复制元数据 #}
{# @param aux_xml boolean optional 在需要时生成.aux.xml边文件 #}
{# @param min_x integer optional 瓦片X坐标最小值 #}
{# @param max_x integer optional 瓦片X坐标最大值 #}
{# @param min_y integer optional 瓦片Y坐标最小值 #}
{# @param max_y integer optional 瓦片Y坐标最大值 #}
{# @param no_intersection_ok boolean optional 数据集范围与瓦片矩阵不交叉仅作为警告 #}

