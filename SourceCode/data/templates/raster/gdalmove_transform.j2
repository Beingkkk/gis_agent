{# @id gdalmove_transform #}
{# @name 栅格坐标转换 #}
{# @description 在不使用重采样的情况下更新栅格文件的坐标系和仿射变换参数 #}
{# @keyword raster #}
{# @keyword tif #}
{# @keyword tiff #}
{# @keyword 坐标系转换 #}
{# @keyword 重投影 #}
{# @keyword geotransform #}
{# @keyword epsg #}
{# @keyword srs #}
{# @keyword gdalwarp #}
{# @concept "gdalmove 仅变换栅格的地理定位信息（坐标系统、仿射变换矩阵），不改变任何像素值，因此不会引入重采样带来的图像损伤" #}
{# @concept "该工具仅适用于线性变换（平移、旋转、缩放），对于复杂非线性变换（如投影间的大范围变形）不建议使用，应改用 gdalwarp" #}
{# @note 如果不指定 -et 参数，工具只会计算并报告预期的像素误差，不会实际修改文件 #}
{# @note 仅支持原地更新的栅格格式（如 GeoTIFF），不支持追加写入的格式 #}
{# @note Python 绑定必须可用才能运行此工具 #}
{# @seealso gdalwarp_reproject #}
{# @seealso ogr2ogr_convert #}
{# @common_error "Unable to open input file" — 目标文件不存在或无法读取，可能是文件格式不支持原地更新 #}
{# @common_error "Pixel error exceeds threshold" — 计算的像素误差超过了指定的 -et 阈值，文件未更新。可增大 -et 值或使用 gdalwarp 进行完整重采样 #}
{# @param target_file file_path required 要操作的栅格文件路径（必须是支持原地更新的格式如 GeoTIFF） #}
{# @param t_srs crs required 目标空间参考系统定义（如 EPSG:4326、EPSG:3857、WKT 字符串） #}
{# @param s_srs crs optional 源数据坐标系统定义，覆盖文件元数据中的坐标系 #}
{# @param et float optional 最大允许像素误差阈值，超过此值则不更新文件 #}

@echo off
REM Generated by GIS Agent
REM Template: gdalmove_transform

gdalmove{% if s_srs %} -s_srs {{ s_srs | quote }}{% endif %} -t_srs {{ t_srs | quote }}{% if et %} -et {{ et }}{% endif %} {{ target_file | safe_path | quote }}

